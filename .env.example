# Billingo díjbekérő API (v3)
# Letrehozas: app.billingo.hu -> Beallitasok -> API kulcsok
# block_id: Beallitasok -> Bizonylattomb (új SkinLab tömb létrehozása ajánlott)
# bank_account_id: Beallitasok -> Bankszamlak
BILLINGO_API_KEY=
BILLINGO_BLOCK_ID=
BILLINGO_BANK_ACCOUNT_ID=
# BILLINGO_API_URL=https://api.billingo.hu/v3  # opcionális override

# CookieYes: az ID literálként a BaseLayout <Tracking cookieYesId=…> propjában él
# (soborbo-tracking). Nem env-fuggo.

# soborbo-tracking market config (build-time; a gateway KV country_code/currency
# értékeivel szinkronban tartandó — lásd a skill docs/cloudflare-setup.md-jét)
PUBLIC_TRACKING_COUNTRY=HU
PUBLIC_TRACKING_CURRENCY=HUF
PUBLIC_TRACKING_LOCALE=hu

# Cloudflare Turnstile PUBLIKUS site key (BUILD-time env: a prerenderelt HTML-be
# égetődik bele). Enélkül a widget NEM renderelődik, a szerver pedig fail-closed
# módon MINDEN űrlapbeküldést elutasít (422 FORM-ZOD-002 / ORDER-TURN-001) —
# némán, egyetlen lead sem jut át. A párja a TURNSTILE_SECRET_KEY, ami
# Cloudflare Worker secret (oda való, nem ide).
# UGYANEZT be kell állítani a Workers Build variables között is
# (Worker → Settings → Build → Variables and secrets), különben a Cloudflare
# oldalán futó build ejti a widgetet.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADJgiQ4n51QgGNDK
