---
/**
 * Modellek 50/50 váltakozó sorokban: galéria + szöveg, ár, részletek gomb.
 * Mobilon a galéria felül. Minden sor `id`-ja a termék slugja, erre görgetnek
 * a hero csempéi és a táblázat „Részletek” linkjei (középre).
 */
import ModelGallery from './ModelGallery.astro';
import ShowcaseIcon from './ShowcaseIcon.astro';
import { formatHuf, type ShowcaseModel } from '@/lib/category-showcase';

interface Props {
  title: string;
  lead: string;
  models: ShowcaseModel[];
}

const { title, lead, models } = Astro.props;
---

<section id="modellek" class="bg-white pt-20 dt:pt-14">
  <div class="sl-reveal mx-auto max-w-7xl px-6 pb-12 text-center dt:pb-10 lg:px-8">
    <h2 class="m-0 font-heading text-[32px] font-normal leading-[1.2] dt:leading-[1.15] text-gray-900 dt:text-[42px]">{title}</h2>
    <p class="mx-auto mt-2.5 max-w-[620px] text-gray-600">{lead}</p>
  </div>

  {models.map((m, i) => (
    <article id={m.slug} class="grid scroll-mt-24 grid-cols-1 dt:min-h-[600px] dt:grid-cols-2">
      <div class:list={['flex items-center justify-center bg-white px-3 pt-10 pb-4 dt:p-12', i % 2 === 1 && 'dt:order-2']}>
        <ModelGallery name={m.name} images={m.images} />
      </div>
      <div class:list={['flex items-center px-6 pt-10 pb-20 dt:justify-center dt:p-16', i % 2 === 0 ? 'bg-blush' : 'bg-white']}>
        <div class="sl-reveal flex max-w-[520px] flex-col gap-5 dt:gap-4">
          <div class="text-xs font-semibold tracking-[0.08em] text-primary-700 uppercase max-dt:hidden">
            {String(i + 1).padStart(2, '0')}{m.keySpec && ` · ${m.keySpec}`} · {m.forWho}
          </div>
          <h3 class="m-0 font-heading text-[38px] font-normal leading-[1.1] text-gray-900 dt:text-[36px]">
            {m.name} <em class="text-primary-700 max-dt:hidden">{m.tagline}</em>
          </h3>
          {/* Mobilon a cím egy stílusban áll, a tagline és a kulcsadat egyszerű alcím. */}
          <div class="-mt-2 text-[17px] text-gray-600 dt:hidden">{m.tagline.charAt(0).toUpperCase() + m.tagline.slice(1)}{m.keySpec && `, ${m.keySpec}`}</div>
          <p class="m-0 max-dt:leading-[1.7] text-gray-700">{m.desc}</p>
          <div class="mt-1 text-base font-semibold text-gray-900 dt:text-sm">Neked való, ha…</div>
          <ul class="m-0 flex flex-col gap-3 p-0 max-dt:list-disc max-dt:pl-5 max-dt:marker:text-primary-700 dt:list-none dt:gap-2" role="list">
            {m.when.map((w) => (
              <li class="text-base text-gray-700 max-dt:list-item max-dt:leading-[1.55] dt:flex dt:gap-2.5 dt:text-[15px]">
                <ShowcaseIcon name="check" size={18} strokeWidth={2.2} class="mt-[3px] shrink-0 text-primary-700 max-dt:hidden" />
                {w}
              </li>
            ))}
          </ul>
          <div class="mt-4 flex flex-col gap-5 dt:mt-2 dt:flex-row dt:flex-wrap dt:items-center dt:gap-x-5 dt:gap-y-4">
            <div>
              <div class="font-heading text-[32px] leading-tight font-normal text-gray-900 dt:font-sans dt:text-2xl dt:leading-8 dt:font-bold">{m.price ? formatHuf(m.price) : 'Kérj ajánlatot'}</div>
              {m.installment && (
                <div class="mt-1 text-[13.5px] text-gray-500 dt:mt-0 dt:text-[12.5px]">
                  vagy 50% előleg + {formatHuf(m.installment.monthly)}/hó ({m.installment.months} hó)
                </div>
              )}
            </div>
            <a href={m.href} class="sl-btn sl-btn-plum min-h-14 dt:min-h-[50px] dt:text-sm" data-select-item={m.sku}>
              {m.name} részletei
            </a>
          </div>
        </div>
      </div>
    </article>
  ))}
</section>
