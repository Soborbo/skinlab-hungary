---
/** „Miért éri meg?” - 4 érv saját, egyszínű ikonnal + kezelésfotó. Mobilon a kép felül. */
import OptimizedPicture from '../images/OptimizedPicture.astro';
import ShowcaseIcon from './ShowcaseIcon.astro';
import type { ShowcaseIconName } from '@/lib/types/category-showcase';
import { getLocaleFromUrl } from '@/i18n/ui';
import { showcaseUi } from '@/i18n/showcase';

interface Props {
  /** Mobilon a szekció végén megjelenő CTA célja. */
  ctaHref?: string;
  title: string;
  lead: string;
  image: string;
  imageAlt: string;
  items: { icon: ShowcaseIconName; title: string; text: string }[];
}

const { title, lead, image, imageAlt, items, ctaHref } = Astro.props;
const ui = showcaseUi(getLocaleFromUrl(Astro.url));
---

<section class="bg-blush py-20 dt:py-[88px]">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-6 dt:grid-cols-2 dt:gap-16 lg:px-8">
    <div class="sl-reveal order-2 dt:order-1">
      <h2 class="m-0 font-heading text-[32px] font-normal leading-[1.2] dt:leading-[1.15] text-gray-900 dt:text-[42px]">{title}</h2>
      <p class="mt-3 mb-9 text-gray-600 dt:mt-2.5 dt:mb-7">{lead}</p>
      <ul class="flex flex-col gap-8 dt:gap-[22px]" role="list">
        {items.map((item) => (
          <li class="wb-item flex gap-4">
            <span class="wb-ico mt-0.5 flex shrink-0 items-center justify-center text-primary-800 dt:mt-0 dt:h-11 dt:w-11 dt:rounded-xl dt:bg-white">
              <ShowcaseIcon name={item.icon} size={22} strokeWidth={1.9} />
            </span>
            <div>
              <div class="text-[17px] font-semibold text-gray-900 dt:text-base">{item.title}</div>
              <div class="mt-1 text-[15px] max-dt:leading-[1.65] text-gray-600 dt:mt-0 dt:text-[14.5px]">{item.text}</div>
            </div>
          </li>
        ))}
      </ul>
      {ctaHref && (
        <a href={ctaHref} class="sl-btn sl-btn-plum mt-10 w-full dt:hidden" data-event="category-consultation-cta-click">{ui.whyBuyCta}</a>
      )}
    </div>
    <div class="sl-reveal order-1 max-dt:-mx-3 max-dt:w-[calc(100%+1.5rem)] dt:order-2">
      <OptimizedPicture
        src={image}
        alt={imageAlt}
        widths={[480, 640, 828, 960]}
        sizes="(min-width: 900px) 45vw, 100vw"
        class="block h-auto w-full dt:aspect-[4/5] dt:rounded-2xl dt:object-cover"
      />
    </div>
  </div>
</section>

<style>
  .wb-ico {
    transition: transform 0.25s ease, background-color 0.25s ease;
  }
  .wb-item:hover .wb-ico {
    transform: rotate(-6deg) scale(1.06);
  }
  @media (min-width: 900px) {
    .wb-item:hover .wb-ico { background-color: var(--color-primary-100); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wb-ico { transition: none; }
    .wb-item:hover .wb-ico { transform: none; }
  }
</style>
