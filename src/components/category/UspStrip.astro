---
/** USP-sáv a hero alatt: 2×2 mobilon, 4 oszlop asztalon, minden pont saját ikonnal. */
import ShowcaseIcon from './ShowcaseIcon.astro';
import type { ShowcaseIconName } from '@/lib/types/category-showcase';

interface Props {
  items: { icon: ShowcaseIconName; title: string; sub: string }[];
}
const { items } = Astro.props;
---

<section class="border-b border-[#f3e4e9] bg-white">
  <ul class="mx-auto grid max-w-7xl grid-cols-2 gap-x-5 gap-y-8 px-6 py-10 dt:grid-cols-4 dt:gap-6 dt:py-[22px] lg:px-8" role="list">
    {items.map((item) => (
      <li class="flex items-start gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blush text-primary-700">
          <ShowcaseIcon name={item.icon} size={18} />
        </span>
        <div>
          <div class="text-sm font-semibold text-gray-900">{item.title}</div>
          <div class="text-[12.5px] text-gray-500">{item.sub}</div>
        </div>
      </li>
    ))}
  </ul>
</section>
