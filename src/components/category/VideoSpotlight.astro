---
/**
 * Videós ügyfélsztori: homok háttér, szó szerinti idézet balra, telefon-keretes
 * videó jobbra. A keret -3°-ról hoverre kiegyenesedik. A videó csak kattintásra
 * töltődik (VideoFacade); a „Nézd meg a videót” gomb ugyanazt indítja.
 * Adat: src/data/video-testimonials.ts + i18n idézet.
 */
import VideoFacade from '../video/VideoFacade.astro';
import ShowcaseIcon from './ShowcaseIcon.astro';
import { t } from '@/i18n/ui';
import { getVideoTestimonial, shortsPoster, videoObjectSchema, type VideoTestimonial } from '@/data/video-testimonials';

interface Props {
  id: VideoTestimonial['id'];
  /** Saját (kivilágosított) poszter; enélkül a YouTube Shorts-bélyegkép. */
  posterSrc?: string;
}

const { id, posterSrc } = Astro.props;
const video = getVideoTestimonial(id);
const role = t('hu', video.roleKey);
const poster = posterSrc ?? shortsPoster(video.videoId);
---

<section class="overflow-hidden bg-sand py-20 dt:py-[88px]">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-6 dt:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] dt:gap-[72px] lg:px-8">
    <div class="sl-reveal order-2 flex flex-col gap-7 dt:order-1 dt:gap-[22px]">
      <span class="self-start rounded-full bg-white px-3.5 py-1.5 text-[13px] font-semibold text-[#5b4636]">Videós vélemény · {video.duration}</span>
      <blockquote class="m-0 font-heading text-[27px] leading-[1.4] text-plum dt:leading-[1.3] dt:text-[34px]">
        <p class="m-0">„{t('hu', video.quoteKey)}”</p>
      </blockquote>
      <div class="flex items-center gap-3.5">
        <img src={poster} alt="" width="56" height="56" loading="lazy" decoding="async" class="h-14 w-14 rounded-full border-[3px] border-white object-cover object-[center_20%]" />
        <div>
          <div class="font-semibold text-plum">{video.name}</div>
          <div class="text-sm text-[#6b5d52]">{role} · {video.business}</div>
        </div>
      </div>
      <button type="button" class="sl-btn sl-btn-plum self-start" data-video-play-for={video.videoId}>
        <ShowcaseIcon name="play" size={16} />
        Nézd meg a videót
      </button>
    </div>

    <div class="relative order-1 flex justify-center py-5 dt:order-2">
      <span class="absolute top-1/2 left-1/2 h-[340px] w-[340px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-sand-deep dt:h-[420px] dt:w-[420px]" aria-hidden="true"></span>
      <div class="vs-phone relative w-[250px] dt:w-[280px]">
        <VideoFacade
          videoId={video.videoId}
          title={`${video.name} (${video.business})`}
          alt={`${video.name} - ${role} (${video.business})`}
          playLabel={`Videó lejátszása: ${video.name} (${video.business})`}
          tone="brand"
          posterSrc={posterSrc}
          class="aspect-[9/16] w-full rounded-[30px] border-[10px] border-plum"
        />
      </div>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(videoObjectSchema(video, 'hu'))} />
</section>

<style>
  .vs-phone {
    border-radius: 30px;
    box-shadow: 0 30px 60px rgba(31, 20, 24, 0.25);
    transform: rotate(-3deg);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.45s ease;
  }
  .vs-phone:hover {
    transform: rotate(0deg) translateY(-6px);
    box-shadow: 0 40px 70px rgba(31, 20, 24, 0.32);
  }
  @media (prefers-reduced-motion: reduce) {
    .vs-phone { transition: none; }
    .vs-phone:hover { transform: rotate(-3deg); }
  }
</style>
