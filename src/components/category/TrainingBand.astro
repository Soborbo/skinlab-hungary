---
/**
 * Képzés-sáv: sötét szilva, szöveg balra a logó vonalához, kép jobbra a szélig.
 * Mobilon a kép felül. A cím asztalon fixen 2 sor.
 *
 * TODO: a fotó (public/hero/hero-gepkezeloi-kepzes-foto, 999×666) pixeles; a
 * tulajdonos nagyobb felbontásút szerez. Felskálázni nem szabad.
 */
import { withTrailingSlash } from '@/i18n/ui';

interface Props {
  titleLines: [string, string];
  text: string;
  cta: string;
  href: string;
}

const { titleLines, text, cta, href } = Astro.props;
const photo = '/hero/hero-gepkezeloi-kepzes-foto';
---

<section class="bg-plum text-white">
  <div class="grid grid-cols-1 dt:min-h-[540px] dt:grid-cols-2">
    <div class="relative aspect-[4/3] overflow-hidden dt:order-2 dt:aspect-auto">
      <picture>
        <source type="image/avif" srcset={`${photo}.avif`} />
        <source type="image/webp" srcset={`${photo}.webp`} />
        <img
          src={`${photo}.jpg`}
          alt="Skinlab gépkezelői képzés a bemutatóteremben"
          width="999"
          height="666"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </picture>
    </div>
    <div class="flex flex-col gap-6 px-6 pt-12 pb-20 dt:order-1 dt:gap-[18px] dt:justify-center dt:py-[72px] dt:pr-16 dt:pl-[max(2rem,calc((100vw-80rem)/2+2rem))]">
      <h2 class="sl-reveal m-0 max-w-[600px] font-heading text-[32px] font-normal leading-[1.2] dt:leading-[1.15] text-white dt:text-[42px]">
        <span class="block dt:whitespace-nowrap">{titleLines[0]}</span>
        <span class="block text-primary-300 dt:whitespace-nowrap">{titleLines[1]}</span>
      </h2>
      <p class="sl-reveal m-0 max-w-[600px] max-dt:leading-[1.7] text-[#e5d5da]">{text}</p>
      <a href={withTrailingSlash(href)} class="sl-btn sl-btn-white self-start">{cta}</a>
    </div>
  </div>
</section>
