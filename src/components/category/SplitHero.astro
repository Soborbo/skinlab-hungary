---
/**
 * Kategória split hero (showcase).
 *
 * Mobilon a kép felül (teljes szélesség), alatta a szöveg; 900px-től a szöveg
 * balra a fejléc logójának vonalához igazodik, a kép jobbra a képernyő széléig
 * fut, padding, kerekítés és hover-effekt nélkül.
 *
 * Kivágás: a kép-doboz a kép saját arányát követi, így a cover-vágás minden
 * szélességen legfeljebb ~15% (MAX_CROP). Asztalon a hero magassága és a
 * kép-oszlop szélessége is a képarányból jön (600-760px, 30-56vw között).
 * A cím asztalon fixen 2 sor. A gépcsempék a modellsorra görgetnek középre
 * (data-scroll-center, a CategoryShowcaseLayout scriptje kezeli).
 */
import OptimizedPicture from '../images/OptimizedPicture.astro';
import ShowcaseIcon from './ShowcaseIcon.astro';
import GoogleMark from './GoogleMark.astro';
import HeroVideo from './HeroVideo.astro';
import { GOOGLE_RATING } from '@/lib/constants';
import { formatHuf, type CatalogGroup, type ShowcaseModel } from '@/lib/category-showcase';
import { getImageEntry } from '@/lib/resolve-image';
import type { ShowcaseHeroVideo } from '@/lib/types/category-showcase';
import { getLocaleFromUrl, getLocalizedUrl } from '@/i18n/ui';
import { showcaseUi } from '@/i18n/showcase';

interface Props {
  titleLines: [string, string];
  lead: string;
  image: string;
  imageAlt: string;
  /** Ha van, a kép helyett néma, ismétlődő hero-videó megy (poszterrel). */
  video?: ShowcaseHeroVideo;
  /** Morzsamenü: a kategória rövid neve. */
  crumb: string;
  models: ShowcaseModel[];
  consultHref: string;
  /** Az összehasonlító szekció horgonya; ha nincs, a sötét gomb elmarad. */
  compareAnchor?: string;
  /** Katalógus-változat: a termékrács horgonya. Ilyenkor a fő gomb oda visz, a konzultáció a második. */
  catalogAnchor?: string;
  /** Katalógus-változat: a csempével rendelkező csoportok (a csempe a csoportra görget). */
  catalogGroups?: CatalogGroup[];
}

const { titleLines, lead, image, imageAlt, video, crumb, models, consultHref, compareAnchor, catalogAnchor, catalogGroups = [] } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const ui = showcaseUi(locale);
// Egytermékes kategória: csempesor helyett egy fekvő kártya, a második gomb a termékoldalra visz.
const single = models.length === 1 ? models[0] : null;
// Katalóguscsempe alja: a csoport legolcsóbb tétele („… Ft-tól”).
function groupFoot(g: CatalogGroup): string {
  const prices = g.items.flatMap((item) => (item.price ? [item.price] : []));
  return prices.length ? ui.priceFrom(formatHuf(Math.min(...prices))) : ui.askPrice;
}
// Hero-csempék: gépes oldalon a gépek, katalógusnál a termékcsoportok.
const tiles = models.length > 1
  ? models.map((m) => ({ href: `#${m.slug}`, thumb: m.thumb, alt: m.fullName, name: m.name, spec: m.keySpec, foot: m.price ? formatHuf(m.price) : ui.askPrice, photo: false }))
  : catalogGroups.flatMap((g) => g.tile && g.anchor
      ? [{ href: `#${g.anchor}`, thumb: g.tile.image, alt: g.title, name: g.tile.name, spec: undefined, foot: groupFoot(g), photo: !!g.tile.photo }]
      : []);
// Csempeoszlopok asztalon a csempék számához igazítva (ne maradjon üres hely).
// 3 csempénél mobilon is egy sor (ne maradjon árva csempe), kisebb képpel és betűvel.
const three = tiles.length === 3;
const tileCols = three
  ? 'grid-cols-3 gap-2.5 dt:grid-cols-3'
  : tiles.length === 2
    ? 'grid-cols-2 gap-3 dt:max-w-[400px]'
    : 'grid-cols-2 gap-3 dt:grid-cols-4';

// Képarány (szélesség/magasság): videónál a poszteré, képnél a manifestből.
const MAX_CROP = 0.85;
const entry = getImageEntry(image);
const ar = video ? video.posterSize.width / video.posterSize.height : entry ? entry.width / entry.height : 1;
// Mobil: a doboz a kép arányát veszi fel, 3:4 (álló) és 1:1 között.
const mobileAr = Math.min(1, Math.max(0.75, ar));
// Asztal: magasság = a 44vw-s oszlophoz illő magasság (600-760px), a szélesség
// pedig ehhez a magassághoz igazodik úgy, hogy a vágás max. 15% legyen (30-56vw).
const heroH = `clamp(600px, calc(44vw / ${ar.toFixed(4)}), 760px)`;
const heroStyle = [
  `--hero-m-ar: ${mobileAr.toFixed(4)}`,
  `--hero-h: ${heroH}`,
  `--hero-img-w: clamp(min(calc(var(--hero-h) * ${(ar * MAX_CROP).toFixed(4)}), 56vw), 44vw, max(30vw, min(calc(var(--hero-h) * ${(ar / MAX_CROP).toFixed(4)}), 56vw)))`,
].join('; ');
const rating = GOOGLE_RATING ? GOOGLE_RATING.value.toFixed(1).replace('.', ',') : null;
const delays = ['[animation-delay:.4s]', '[animation-delay:.5s]', '[animation-delay:.6s]', '[animation-delay:.7s]'];
---

<section class="bg-blush" data-showcase-hero style={heroStyle}>
  <div class="grid grid-cols-1 dt:grid-cols-[minmax(0,1fr)_var(--hero-img-w)] dt:min-h-(--hero-h)">
    <div class="relative aspect-(--hero-m-ar) bg-plum dt:order-2 dt:aspect-auto dt:overflow-hidden">
      {video ? (
        <HeroVideo {...video} alt={imageAlt} />
      ) : (
        <OptimizedPicture
          src={image}
          alt={imageAlt}
          widths={[480, 640, 828, 960, 1200]}
          sizes="(min-width: 900px) 56vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
        />
      )}
      {rating && (
        <a
          href="#velemenyek"
          data-scroll-center
          class="sl-rise [animation-delay:.5s] absolute -bottom-[26px] left-6 z-10 flex items-center gap-3 rounded-[14px] bg-white px-[18px] py-3 shadow-[0_10px_30px_rgba(0,0,0,.14)] dt:bottom-6 dt:left-6 dt:px-[18px] dt:py-3"
        >
          <GoogleMark size={30} />
          <span class="flex flex-col leading-tight">
            <span class="flex items-center gap-2">
              <strong class="text-[22px] text-gray-900">{rating}</strong>
              <span class="text-[15px] tracking-[1px] text-[#fbbc04]" aria-hidden="true">★★★★★</span>
            </span>
            <span class="text-xs text-gray-600">{ui.googleReviews}</span>
          </span>
        </a>
      )}
    </div>

    <div class="flex flex-col gap-6 px-6 pt-[58px] pb-14 dt:order-1 dt:justify-center dt:gap-5 dt:py-10 dt:pr-12 dt:pl-[max(2rem,calc((100vw-80rem)/2+2rem))] xl:pr-20">
      <nav aria-label={ui.breadcrumb} class="text-[13px] text-gray-600">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href={getLocalizedUrl(locale, '/')} class="text-gray-600 hover:text-primary-700">{ui.home}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gray-900" aria-current="page">{crumb}</li>
        </ol>
      </nav>

      <h1 class="m-0 font-heading text-[40px] font-normal leading-[1.15] dt:leading-[1.1] tracking-[-0.01em] text-gray-900 dt:whitespace-nowrap dt:text-[clamp(2.1rem,3.35vw,3rem)]">
        {/* Mobilon egy folyó mondat (max. 3 sor), asztalon fixen 2 sor. */}
        <span class="dt:block">{titleLines[0]}</span>{' '}
        <span class="dt:block dt:text-primary-700">{titleLines[1]}</span>
      </h1>

      <p class="m-0 max-w-[560px] text-[17px] max-dt:leading-[1.7] text-gray-700">{lead}</p>

      <div class="sl-rise [animation-delay:.3s] grid max-w-[520px] grid-cols-2 gap-3">
        {catalogAnchor ? (
          <>
            <a href={`#${catalogAnchor}`} class="sl-btn sl-btn-pink px-1.5 text-[13px] min-[400px]:px-2.5 min-[400px]:text-sm dt:text-[15px]" data-scroll-center>
              {ui.catalogCta}
            </a>
            <a href={consultHref} class="sl-btn sl-btn-plum px-1.5 text-[13px] min-[400px]:px-2.5 min-[400px]:text-sm dt:text-[15px]" data-event="category-consultation-cta-click">
              {ui.consultCta}
            </a>
          </>
        ) : (
        <a href={consultHref} class="sl-btn sl-btn-pink px-1.5 text-[13px] min-[400px]:px-2.5 min-[400px]:text-sm dt:text-[15px]" data-event="category-consultation-cta-click">
          {ui.consultCta}
        </a>
        )}
        {catalogAnchor ? null : compareAnchor ? (
          <a href={`#${compareAnchor}`} class="sl-btn sl-btn-plum px-1.5 text-[13px] min-[400px]:px-2.5 min-[400px]:text-sm dt:text-[15px]" data-scroll-center>
            <ShowcaseIcon name="table" size={18} />
            {ui.compareCta}
          </a>
        ) : single && (
          <a href={single.href} class="sl-btn sl-btn-plum px-1.5 text-[13px] min-[400px]:px-2.5 min-[400px]:text-sm dt:text-[15px]" data-select-item={single.sku}>
            {ui.singleDetails}
          </a>
        )}
      </div>

      {single ? (
        <a
          href={`#${single.slug}`}
          data-scroll-center
          class="sl-pop sl-lift group mt-2 flex max-w-[420px] items-center gap-4 overflow-hidden rounded-[14px] bg-white p-3 pr-5 text-gray-900 [animation-delay:.4s] [&>picture]:block [&>picture]:shrink-0"
        >
          <OptimizedPicture
            src={single.thumb}
            alt={single.fullName}
            widths={[160, 320]}
            sizes="120px"
            class="h-[110px] w-[110px] object-contain transition-transform duration-[350ms] group-hover:scale-[1.07] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          />
          <span class="flex flex-col gap-0.5">
            <span class="text-base font-bold">{single.name}</span>
            {single.keySpec && <span class="text-[13px] text-gray-500">{single.keySpec}</span>}
            <span class="mt-1.5 text-sm font-semibold">{single.price ? formatHuf(single.price) : ui.askPrice}</span>
          </span>
        </a>
      ) : tiles.length > 1 && (
      <ul class:list={['mt-2 grid max-w-[600px] dt:mt-2 dt:gap-2.5', tileCols]} role="list">
        {tiles.map((m, i) => (
          <li class:list={['sl-pop', delays[i % delays.length]]}>
            <a
              href={m.href}
              data-scroll-center
              class="sl-lift group flex h-full flex-col overflow-hidden rounded-[14px] bg-white text-gray-900"
            >
              <span class:list={['flex items-center justify-center [&>picture]:block [&>picture]:h-full [&>picture]:w-full', m.photo ? 'overflow-hidden dt:h-[120px]' : 'p-2 dt:h-[84px] dt:p-1.5', three ? 'h-[100px]' : 'h-[140px]']}>
                <OptimizedPicture
                  src={m.thumb}
                  alt={m.alt}
                  widths={[160, 320]}
                  sizes="150px"
                  class={`h-full w-full ${m.photo ? 'object-cover' : 'object-contain'} transition-transform duration-[350ms] group-hover:scale-[1.07] motion-reduce:transition-none motion-reduce:group-hover:scale-100`}
                />
              </span>
              <span class:list={['flex grow flex-col gap-px border-t border-[#fbe3ea] pt-2 dt:px-2.5 dt:pb-2.5', three ? 'px-2.5 pt-2.5 pb-3 dt:pt-2' : 'px-4 pt-3 pb-4 dt:pt-2']}>
                <span class:list={['font-bold dt:text-sm', three ? 'text-[13px] leading-tight' : 'text-sm']}>
                  {m.name} {m.spec && <span class:list={['text-xs font-medium whitespace-nowrap text-gray-500', three && 'block']}>{m.spec}</span>}
                </span>
                <span class="mt-auto text-[13px] font-semibold">{m.foot}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      )}
    </div>
  </div>
</section>
