---
/**
 * Kategória split hero (showcase).
 *
 * Mobilon a kép felül (négyzetes, teljes szélesség), alatta a szöveg; 900px-től
 * a szöveg balra a fejléc logójának vonalához igazodik, a kép jobbra a
 * képernyő széléig fut, padding, kerekítés és hover-effekt nélkül.
 * A cím asztalon fixen 2 sor. A gépcsempék a modellsorra görgetnek középre
 * (data-scroll-center, a CategoryShowcaseLayout scriptje kezeli).
 */
import OptimizedPicture from '../images/OptimizedPicture.astro';
import ShowcaseIcon from './ShowcaseIcon.astro';
import GoogleMark from './GoogleMark.astro';
import HeroVideo from './HeroVideo.astro';
import { GOOGLE_RATING } from '@/lib/constants';
import { formatHuf, type ShowcaseModel } from '@/lib/category-showcase';
import type { ShowcaseHeroVideo } from '@/lib/types/category-showcase';

interface Props {
  titleLines: [string, string];
  lead: string;
  image: string;
  imageAlt: string;
  /** Ha van, a kép helyett néma, ismétlődő hero-videó megy (poszterrel). */
  video?: ShowcaseHeroVideo;
  /** Morzsamenü: a kategória rövid neve. */
  crumb: string;
  models: ShowcaseModel[];
  consultHref: string;
  /** Az összehasonlító szekció horgonya; ha nincs, a sötét gomb elmarad. */
  compareAnchor?: string;
}

const { titleLines, lead, image, imageAlt, video, crumb, models, consultHref, compareAnchor } = Astro.props;
// Csempeoszlopok asztalon a gépek számához igazítva (3 gépnél ne maradjon üres hely).
// 3 gépnél mobilon is egy sor (ne maradjon árva csempe), kisebb képpel és betűvel.
const three = models.length === 3;
const tileCols = three ? 'grid-cols-3 gap-2.5 dt:grid-cols-3' : 'grid-cols-2 gap-3 dt:grid-cols-4';
const rating = GOOGLE_RATING ? GOOGLE_RATING.value.toFixed(1).replace('.', ',') : null;
const delays = ['[animation-delay:.4s]', '[animation-delay:.5s]', '[animation-delay:.6s]', '[animation-delay:.7s]'];
---

<section class="bg-blush">
  <div class="grid grid-cols-1 dt:grid-cols-[minmax(0,1.12fr)_minmax(0,0.88fr)] dt:min-h-[600px]">
    <div class="relative aspect-[39/46] bg-plum dt:order-2 dt:aspect-auto dt:overflow-hidden">
      {video ? (
        <HeroVideo {...video} alt={imageAlt} />
      ) : (
        <OptimizedPicture
          src={image}
          alt={imageAlt}
          widths={[480, 640, 828, 960, 1200]}
          sizes="(min-width: 900px) 44vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
        />
      )}
      {rating && (
        <a
          href="#velemenyek"
          data-scroll-center
          class="sl-rise [animation-delay:.5s] absolute -bottom-[26px] left-6 z-10 flex items-center gap-3 rounded-[14px] bg-white px-[18px] py-3 shadow-[0_10px_30px_rgba(0,0,0,.14)] dt:bottom-6 dt:left-6 dt:px-[18px] dt:py-3"
        >
          <GoogleMark size={30} />
          <span class="flex flex-col leading-tight">
            <span class="flex items-center gap-2">
              <strong class="text-[22px] text-gray-900">{rating}</strong>
              <span class="text-[15px] tracking-[1px] text-[#fbbc04]" aria-hidden="true">★★★★★</span>
            </span>
            <span class="text-xs text-gray-600">Google-értékelések</span>
          </span>
        </a>
      )}
    </div>

    <div class="flex flex-col gap-6 px-6 pt-[58px] pb-14 dt:order-1 dt:justify-center dt:gap-5 dt:py-10 dt:pr-12 dt:pl-[max(2rem,calc((100vw-80rem)/2+2rem))] xl:pr-20">
      <nav aria-label="Morzsamenü" class="text-[13px] text-gray-600">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="text-gray-600 hover:text-primary-700">Főoldal</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gray-900" aria-current="page">{crumb}</li>
        </ol>
      </nav>

      <h1 class="m-0 font-heading text-[40px] font-normal leading-[1.15] dt:leading-[1.1] tracking-[-0.01em] text-gray-900 dt:whitespace-nowrap dt:text-[clamp(2.1rem,3.35vw,3rem)]">
        {/* Mobilon egy folyó mondat (max. 3 sor), asztalon fixen 2 sor. */}
        <span class="dt:block">{titleLines[0]}</span>{' '}
        <span class="dt:block dt:text-primary-700">{titleLines[1]}</span>
      </h1>

      <p class="m-0 max-w-[560px] text-[17px] max-dt:leading-[1.7] text-gray-700">{lead}</p>

      <div class="sl-rise [animation-delay:.3s] grid max-w-[520px] grid-cols-2 gap-3">
        <a href={consultHref} class="sl-btn sl-btn-pink px-2.5 text-sm dt:text-[15px]" data-event="category-consultation-cta-click">
          Ingyenes konzultáció
        </a>
        {compareAnchor && (
          <a href={`#${compareAnchor}`} class="sl-btn sl-btn-plum px-2.5 text-sm dt:text-[15px]" data-scroll-center>
            <ShowcaseIcon name="table" size={18} />
            Összehasonlítás
          </a>
        )}
      </div>

      <ul class:list={['mt-2 grid max-w-[600px] dt:mt-2 dt:gap-2.5', tileCols]} role="list">
        {models.map((m, i) => (
          <li class:list={['sl-pop', delays[i % delays.length]]}>
            <a
              href={`#${m.slug}`}
              data-scroll-center
              class="sl-lift group flex h-full flex-col overflow-hidden rounded-[14px] bg-white text-gray-900"
            >
              <span class:list={['flex items-center justify-center p-2 dt:h-[84px] dt:p-1.5 [&>picture]:block [&>picture]:h-full [&>picture]:w-full', three ? 'h-[100px]' : 'h-[140px]']}>
                <OptimizedPicture
                  src={m.thumb}
                  alt={`${m.name} diódalézer`}
                  widths={[160, 320]}
                  sizes="150px"
                  class="h-full w-full object-contain transition-transform duration-[350ms] group-hover:scale-[1.07] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                />
              </span>
              <span class:list={['flex grow flex-col gap-px border-t border-[#fbe3ea] pt-2 dt:px-2.5 dt:pb-2.5', three ? 'px-2.5 pt-2.5 pb-3 dt:pt-2' : 'px-4 pt-3 pb-4 dt:pt-2']}>
                <span class:list={['font-bold dt:text-sm', three ? 'text-[13px] leading-tight' : 'text-sm']}>
                  {m.name} {m.keySpec && <span class:list={['text-xs font-medium whitespace-nowrap text-gray-500', three && 'block']}>{m.keySpec}</span>}
                </span>
                <span class="mt-auto text-[13px] font-semibold">{m.price ? formatHuf(m.price) : 'Kérj ajánlatot'}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
