---
/**
 * VideoQuote - Egy vásárlói videó + szó szerinti idézet a videóból.
 *
 * Desktopon a videó (9:16) az egyik oldalon, az idézet a másikon (`align`);
 * mobilon egymás alatt: idézet → nagy videó → név. Így a látogató a videó
 * elindítása nélkül is megkapja a lényeget.
 *
 * Adatok: src/data/video-testimonials.ts (idézetek i18n kulcsokon).
 */
import { t, getLocaleFromUrl, type Locale } from '../../i18n/ui';
import VideoFacade from './VideoFacade.astro';
import { MOBILE_MEDIA_BLEED } from '@/lib/ui-classes';
import { getVideoTestimonial, videoObjectSchema, type VideoTestimonial } from '../../data/video-testimonials';

interface Props {
  testimonial: VideoTestimonial['id'];
  /** Melyik oldalon legyen a videó desktopon. */
  videoSide?: 'left' | 'right';
}

const { testimonial, videoSide = 'left' } = Astro.props;
const locale = getLocaleFromUrl(Astro.url) as Locale;
const item = getVideoTestimonial(testimonial);
const role = `${t(locale, item.roleKey)} · ${item.business}`;
---

<section class="py-12 lg:py-16 bg-primary-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class:list={[
      'flex flex-col gap-6 lg:items-center lg:gap-16',
      // DOM-sorrend: idézet, videó → 'right' = flex-row, 'left' = flex-row-reverse
      videoSide === 'left' ? 'lg:flex-row-reverse' : 'lg:flex-row',
    ]}>
      <figure class="contents lg:flex lg:flex-1 lg:flex-col lg:gap-7">
        <svg class="order-1 w-10 h-8 lg:w-14 lg:h-11 text-primary-500" viewBox="0 0 56 44" fill="currentColor" aria-hidden="true">
          <path d="M0 44V26C0 11 7 2 21 0l2 6C15 8 11 13 11 20h10v24H0zm33 0V26C33 11 40 2 54 0l2 6c-8 2-12 7-12 14h10v24H33z"/>
        </svg>
        <blockquote class="order-2 text-xl sm:text-2xl lg:text-[2rem] font-semibold leading-snug text-gray-900">
          <p>{t(locale, item.quoteKey)}</p>
        </blockquote>
        <figcaption class="order-4 flex flex-col gap-1">
          <span class="text-lg font-bold text-gray-900">{item.name}</span>
          <span class="text-gray-600">{role}</span>
          <button type="button" data-video-play-for={item.videoId} class="hidden lg:inline-flex self-start mt-3 font-semibold text-primary-700 hover:text-primary-800 cursor-pointer">
            ▶ {t(locale, 'videoTestimonials.watchFull', { duration: item.duration })}
          </button>
        </figcaption>
      </figure>

      <div class:list={['order-3 lg:order-none relative w-full max-w-sm mx-auto lg:mx-0 lg:w-[300px] lg:flex-shrink-0', MOBILE_MEDIA_BLEED]}>
        <VideoFacade
          videoId={item.videoId}
          title={`${item.name} (${item.business})`}
          alt={`${item.name} – ${role}`}
          playLabel={`${t(locale, 'videoTestimonials.playLabel')}: ${item.name}`}
          class="aspect-[9/16] rounded-2xl shadow-lg"
        >
          <span class="absolute right-3 top-3 rounded-full bg-black/60 px-2.5 py-1 text-xs font-semibold text-white pointer-events-none">{item.duration}</span>
        </VideoFacade>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(videoObjectSchema(item, locale))} />
</section>
