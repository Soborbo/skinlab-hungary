---
/**
 * Rólunk oldal a kategóriaoldalak (showcase) dizájnnyelvén: blush split hero,
 * USP-sáv, homok idézetsáv, váltakozó történet-sorok, „miben vagyunk mások”,
 * egyforma csapatkártyák, videós vélemények, látogatás-blokk.
 * Terv: https://claude.ai/artifact/UTGfvFWWnoEmGbBkGsg2wY
 *
 * Szöveg: about.* az i18n JSON-okban. A történet bekezdései (storySection*)
 * egyelőre csak magyarul vannak meg, a többi nyelven magyarra esnek vissza.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoTestimonials from '../sections/VideoTestimonials.astro';
import OptimizedPicture from '../images/OptimizedPicture.astro';
import UspStrip from '../category/UspStrip.astro';
import GoogleMark from '../category/GoogleMark.astro';
import ShowcaseIcon from '../category/ShowcaseIcon.astro';
import { SITE, COMPANY, CONTACT, GOOGLE_RATING, LOCATIONS, TEAM } from '../../lib/constants';
import { getImageEntry } from '../../lib/resolve-image';
import { t, getLocaleFromUrl, getLocalizedUrl, type Locale } from '../../i18n/ui';
import { config } from '../../config/siteConfig';
import { aboutPageSchema } from '../../config/schema';

const locale = getLocaleFromUrl(Astro.url) as Locale;
const a = (key: string, params?: Record<string, string | number>) => t(locale, `about.${key}`, params);
const brand = { companyName: COMPANY.brand };

const consultHref = getLocalizedUrl(locale, '/konzultacio');
const pageUrl = `${SITE.url}${getLocalizedUrl(locale, '/rolunk')}`;
const rating = GOOGLE_RATING ? GOOGLE_RATING.value.toFixed(1).replace('.', ',') : null;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(LOCATIONS.showroom.fullAddress)}`;
const founders = TEAM.slice(0, 2);

// Hero: a kép-doboz a fotó arányát követi (mint a SplitHero), így a vágás kicsi marad.
const HERO_IMAGE = '@assets/rolunk2.jpg';
const heroEntry = getImageEntry(HERO_IMAGE);
const heroAr = heroEntry ? heroEntry.width / heroEntry.height : 4 / 3;
const heroStyle = [
  `--about-h: clamp(480px, calc(50vw / ${heroAr.toFixed(4)}), 700px)`,
  `--about-img-w: clamp(min(calc(var(--about-h) * ${(heroAr * 0.85).toFixed(4)}), 56vw), 50vw, min(calc(var(--about-h) * ${(heroAr / 0.85).toFixed(4)}), 56vw))`,
].join('; ');

// Történet: váltakozó sorok, a kép a képernyő széléig.
const story = [
  {
    title: a('storySection1Title'),
    paras: [a('storySection1')],
    image: '@assets/rolunk5.jpg',
    imageAlt: 'Gaszler Szimonetta egy nemzetközi kozmetikai szakkiállításon',
  },
  {
    title: a('storySection2Title'),
    paras: [a('storySection2a'), a('storySection2b', brand)],
    image: '@assets/rolunk4.jpg',
    imageAlt: 'Horváth László a Skinlab bemutatótermében',
  },
  {
    title: a('storySection3Title'),
    paras: [a('storySection3')],
    image: '@assets/rolunk6.jpg',
    imageAlt: 'A Skinlab csapata egy szakkiállítási standon, skinlab márkás készülékekkel',
  },
  {
    title: a('storySection4Title', brand),
    paras: [a('storySection4a', brand), a('storySection4b', brand)],
    image: '@assets/skinlab-csapat-milano.jpg',
    imageAlt: 'A Skinlab csapata Milánóban',
  },
];

const values = [
  { icon: 'check', n: 1 },
  { icon: 'wrench', n: 2 },
  { icon: 'phone', n: 3 },
  { icon: 'sparkles', n: 4 },
] as const;
---

<BaseLayout
  title={t(locale, 'about.title', brand)}
  description={t(locale, 'about.subtitle', brand)}
  schema={aboutPageSchema(config, pageUrl)}
>
  {/* 1. Hero: blush split, szöveg balra a logó vonalához, kép jobbra a képernyő széléig */}
  <section class="bg-blush" style={heroStyle}>
    <div class="grid grid-cols-1 dt:min-h-(--about-h) dt:grid-cols-[minmax(0,1fr)_var(--about-img-w)]">
      <div class="relative aspect-[4/3] bg-plum dt:order-2 dt:aspect-auto">
        <OptimizedPicture
          src={HERO_IMAGE}
          alt={a('heroAlt')}
          widths={[480, 640, 828, 960, 1200, 1600]}
          sizes="(min-width: 900px) 56vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover object-[center_35%]"
        />
        {rating && (
          <a
            href="#velemenyek"
            class="sl-rise [animation-delay:.5s] absolute -bottom-[26px] left-6 z-10 flex items-center gap-3 rounded-[14px] bg-white px-[18px] py-3 shadow-[0_10px_30px_rgba(0,0,0,.14)] dt:bottom-6"
          >
            <GoogleMark size={30} />
            <span class="flex flex-col leading-tight">
              <span class="flex items-center gap-2">
                <strong class="text-[22px] text-gray-900">{rating}</strong>
                <span class="text-[15px] tracking-[1px] text-[#fbbc04]" aria-hidden="true">★★★★★</span>
              </span>
              <span class="text-xs text-gray-600">{t(locale, 'homeHero.googleRating')}</span>
            </span>
          </a>
        )}
      </div>

      <div class="flex flex-col gap-6 px-6 pt-[58px] pb-14 dt:order-1 dt:justify-center dt:gap-5 dt:py-12 dt:pr-10 dt:pl-[max(2rem,calc((100vw-80rem)/2+2rem))] xl:pr-14">
        <nav aria-label="Breadcrumb" class="text-[13px] text-gray-600">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href={getLocalizedUrl(locale, '/')} class="text-gray-600 hover:text-primary-700">{t(locale, 'nav.home')}</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-gray-900" aria-current="page">{t(locale, 'nav.about')}</li>
          </ol>
        </nav>

        <h1 class="m-0 font-heading text-[38px] font-normal leading-[1.15] tracking-[-0.01em] text-balance text-gray-900 dt:text-[clamp(2.1rem,3.3vw,3rem)] dt:leading-[1.1]">
          <span class="dt:block">{a('heroLine1')}</span>{' '}
          <span class="dt:block dt:text-primary-700">{a('heroLine2')}</span>
        </h1>

        <p class="m-0 max-w-[560px] text-[17px] text-gray-700 max-dt:leading-[1.7]">{a('heroLead')}</p>

        <div class="sl-rise [animation-delay:.2s] grid max-w-[520px] grid-cols-2 gap-3">
          <a href={consultHref} class="sl-btn sl-btn-pink px-2.5 text-sm xl:text-[15px]" data-event="about-consultation-cta-click">{t(locale, 'header.freeConsultation')}</a>
          <a href="#csapat" class="sl-btn sl-btn-plum px-2.5 text-sm xl:text-[15px]">{a('teamCta')}</a>
        </div>

        {/* 900-1279px között rejtve: ott a hero magasabb lenne a képnél, és a fotóból sok veszne el. */}
        <ul class="mt-1 grid max-w-[520px] grid-cols-1 gap-2.5 dt:hidden xl:grid xl:grid-cols-2" role="list">
          {founders.map((f, i) => (
            <li class="sl-pop" style={`animation-delay:${0.3 + i * 0.1}s`}>
              <a href="#csapat" class="sl-lift flex items-center gap-3 rounded-[14px] bg-white px-3.5 py-2.5 text-gray-900">
                <picture class="shrink-0">
                  <source type="image/avif" srcset={`${f.image}.avif`} />
                  <source type="image/webp" srcset={`${f.image}.webp`} />
                  <img src={`${f.image}.jpg`} alt="" width="52" height="52" loading="eager" class="h-[52px] w-[52px] rounded-full object-cover object-[center_20%]" />
                </picture>
                <span class="flex flex-col leading-snug">
                  <strong class="text-[15px]">{f.name}</strong>
                  <span class="text-[13px] text-gray-500">{a(f.roleKey)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* 2. USP-sáv, a kategóriaoldalak komponense */}
  <UspStrip
    items={[
      { icon: 'wrench', title: a('uspServiceTitle'), sub: a('uspServiceSub') },
      { icon: 'academic', title: a('uspTrainingTitle'), sub: a('uspTrainingSub') },
      { icon: 'pin', title: a('uspShowroomTitle'), sub: a('uspShowroomSub') },
      { icon: 'shield', title: a('uspWarrantyTitle'), sub: a('uspWarrantySub') },
    ]}
  />

  {/* 3. Idézet: homok sáv, serif idézet, az alapítók avatarjaival */}
  <section class="bg-sand py-20 dt:py-24">
    <figure class="sl-reveal mx-auto flex max-w-[880px] flex-col items-center gap-7 px-6 text-center">
      <svg width="40" height="32" viewBox="0 0 40 32" aria-hidden="true"><path fill="#fe6893" d="M0 32V19.2C0 8.6 5.4 2.2 16.2 0l1.6 4.2C12 6 9.2 9.6 8.8 14.4H16V32H0zm22 0V19.2C22 8.6 27.4 2.2 38.2 0l1.6 4.2C34 6 31.2 9.6 30.8 14.4H38V32H22z" /></svg>
      <blockquote class="m-0 font-heading text-[26px] leading-[1.4] text-plum dt:text-[30px]">{a('storyClosing')}</blockquote>
      <figcaption class="flex items-center gap-3.5 text-left">
        <span class="flex">
          {founders.map((f, i) => (
            <img src={`${f.image}.jpg`} alt="" width="52" height="52" loading="lazy" class:list={['h-[52px] w-[52px] rounded-full border-[3px] border-sand object-cover object-[center_20%] shadow-[0_4px_12px_rgba(0,0,0,.1)]', i > 0 && '-ml-3.5']} />
          ))}
        </span>
        <span class="leading-snug">
          <strong class="block text-[15px] text-plum">{founders.map((f) => f.name).join(' & ')}</strong>
          <span class="text-[13px] text-[#6b5d52]">{a('quoteRole')}</span>
        </span>
      </figcaption>
    </figure>
  </section>

  {/* 4. Történet: váltakozó osztott sorok, sorszám-jelvények nélkül */}
  <section id="tortenet" class="bg-white">
    <div class="sl-reveal mx-auto max-w-[680px] px-6 pt-20 pb-12 text-center dt:pt-24">
      <h2 class="m-0 font-heading text-[32px] font-normal leading-[1.2] text-gray-900 dt:text-[42px]">{a('storyTitle')}</h2>
      <p class="mt-3 text-gray-600 max-dt:leading-[1.7]">{a('storyLead')}</p>
    </div>
    {story.map((chapter, i) => {
      const flip = i % 2 === 1;
      // A kép-doboz a fotó arányát veszi fel; 1280px fölött a sor magasságáig nyúlik (a vágás így kicsi marad),
      // alatta a hosszabb szöveg mellett függőlegesen középre kerül, hogy ne vágjon sokat.
      return (
        <div class="grid grid-cols-1 dt:grid-cols-2">
          <div class:list={['relative aspect-[4/3] overflow-hidden dt:self-center xl:self-stretch', flip && 'dt:order-2']}>
            <OptimizedPicture
              src={chapter.image}
              alt={chapter.imageAlt}
              widths={[480, 640, 828, 960, 1200]}
              sizes="(min-width: 900px) 50vw, 100vw"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
          <div class:list={['sl-reveal flex flex-col justify-center gap-3.5 px-6 pt-9 pb-14 dt:py-16', flip ? 'dt:pr-14 dt:pl-[max(2rem,calc((100vw-80rem)/2+2rem))]' : 'dt:px-16 xl:px-20']}>
            <h3 class="m-0 max-w-[540px] font-heading text-[28px] font-normal leading-[1.2] text-gray-900 dt:text-[34px]">{chapter.title}</h3>
            {chapter.paras.map((p) => <p class="m-0 max-w-[540px] leading-[1.75] text-gray-600">{p}</p>)}
            {i === story.length - 1 && (
              <div class="mt-2"><a href={consultHref} class="sl-btn sl-btn-pink">{t(locale, 'header.freeConsultation')}</a></div>
            )}
          </div>
        </div>
      );
    })}
  </section>

  {/* 5. Miben vagyunk mások: homok felület, lista hajszálvonalakkal */}
  <section class="bg-sand py-20 dt:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-9 px-6 dt:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] dt:gap-[72px] lg:px-8">
      <div class="sl-reveal flex flex-col gap-4">
        <h2 class="m-0 font-heading text-[32px] font-normal leading-[1.2] text-gray-900 dt:text-[42px]">{a('diffTitle')}</h2>
        <p class="m-0 text-gray-600 max-dt:leading-[1.7]">{a('diffLead')}</p>
        <div class="mt-2"><a href="#csapat" class="sl-btn sl-btn-plum">{a('teamCta')}</a></div>
      </div>
      <ul class="grid grid-cols-1 dt:grid-cols-2 dt:gap-x-10" role="list">
        {values.map((v) => (
          <li class="group flex items-start gap-4 border-t border-[#e9ddd0] py-[22px]">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-plum transition-[transform,background-color] duration-[250ms] group-hover:-rotate-6 group-hover:scale-[1.06] group-hover:bg-primary-100 motion-reduce:transition-none">
              <ShowcaseIcon name={v.icon} size={22} />
            </span>
            <div>
              <strong class="block text-base text-gray-900">{a(`value${v.n}Title`)}</strong>
              <p class="mt-1.5 mb-0 text-[15px] leading-[1.65] text-gray-600">{a(`value${v.n}Text`)}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 6. Csapat: mindenki egyforma kártyán; fotó nélkül monogramos avatar. Asztalon soronként 4, a csonka sor középen. */}
  <section id="csapat" class="scroll-mt-24 bg-white py-20 dt:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="sl-reveal mx-auto mb-12 max-w-[640px] text-center">
        <h2 class="m-0 font-heading text-[32px] font-normal leading-[1.2] text-gray-900 dt:text-[42px]">{a('teamTitle')}</h2>
        <p class="mt-3 text-gray-600 max-dt:leading-[1.7]">{a('teamLead')}</p>
      </div>
      <ul class="-mx-3 grid grid-cols-1 gap-4 dt:mx-0 dt:flex dt:flex-wrap dt:justify-center dt:gap-6" role="list">
        {TEAM.map((m) => (
          <li class="sl-lift group flex flex-col overflow-hidden rounded-[20px] border border-[#f3e4e9] bg-white dt:w-[calc((100%-72px)/4)]">
            <div class="aspect-square w-full overflow-hidden bg-plum">
              {m.image ? (
                <picture>
                  <source type="image/avif" srcset={`${m.image}.avif`} />
                  <source type="image/webp" srcset={`${m.image}.webp`} />
                  <img src={`${m.image}.jpg`} alt={m.name} width="960" height="960" loading="lazy" class="block h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transition-none" />
                </picture>
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-sand" role="img" aria-label={m.name}>
                  <span class="font-heading text-[64px] text-[#6b5d52]" aria-hidden="true">{m.initials}</span>
                </div>
              )}
            </div>
            <div class="flex flex-col gap-1 px-6 pt-5 pb-6 dt:px-[22px] dt:pt-[22px] dt:pb-[26px]">
              <h3 class="m-0 font-heading text-2xl font-normal text-gray-900">{m.name}</h3>
              <span class="text-[13px] leading-snug font-semibold text-primary-700">{a(m.roleKey)}</span>
              <p class="mt-1.5 mb-0 text-sm leading-[1.65] text-gray-600">{a(m.bioKey)}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="sl-reveal mt-10 flex flex-wrap items-center justify-center gap-4">
        <span class="flex">
          {founders.map((f, i) => (
            <img src={`${f.image}.jpg`} alt="" width="48" height="48" loading="lazy" class:list={['h-12 w-12 rounded-full border-[3px] border-white object-cover object-[center_20%] shadow-[0_4px_12px_rgba(0,0,0,.1)]', i > 0 && '-ml-3.5']} />
          ))}
        </span>
        <span class="text-[15px] font-semibold text-plum">{a('helpText')}</span>
        <a href={CONTACT.phoneTel} class="sl-btn sl-btn-plum h-12">
          <ShowcaseIcon name="phone" size={16} />
          {CONTACT.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  {/* 7. Videós vélemények (márkaszintű bizonyíték), showcase stílusban */}
  <VideoTestimonials quotes showcase />

  {/* 8. Látogatás: cím, nyitvatartás, telefon, e-mail, térkép; jobbra a bemutatóterem, vágás nélkül */}
  <section class="bg-white">
    <div class="grid grid-cols-1 items-center dt:grid-cols-2">
      <div class="sl-reveal flex flex-col gap-4 px-6 pt-20 pb-10 dt:py-24 dt:pr-16 dt:pl-[max(2rem,calc((100vw-80rem)/2+2rem))]">
        <h2 class="m-0 font-heading text-[32px] font-normal leading-[1.2] text-gray-900 dt:text-[42px]">{a('visitTitle')}</h2>
        <p class="m-0 max-w-[500px] leading-[1.7] text-gray-600">{a('visitText')}</p>
        <dl class="m-0 mt-1 max-w-[500px]">
          {[
            { icon: 'pin', label: a('visitAddress'), value: LOCATIONS.showroom.fullAddress },
            { icon: 'clock', label: t(locale, 'contact.openingHours'), value: a('visitHours') },
          ].map((row) => (
            <div class="flex items-start gap-3.5 border-b border-[#f0e6ea] py-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] bg-sand text-[#5b4636]"><ShowcaseIcon name={row.icon as 'pin'} size={18} /></span>
              <div><dt class="text-[13px] text-[#6b5d52]">{row.label}</dt><dd class="m-0 font-medium text-gray-900">{row.value}</dd></div>
            </div>
          ))}
          <div class="flex items-start gap-3.5 border-b border-[#f0e6ea] py-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] bg-sand text-[#5b4636]"><ShowcaseIcon name="phone" size={18} /></span>
            <div><dt class="text-[13px] text-[#6b5d52]">{t(locale, 'contact.phone')}</dt><dd class="m-0"><a href={CONTACT.phoneTel} class="sl-tlink font-medium text-gray-900">{CONTACT.phoneDisplay}</a></dd></div>
          </div>
          <div class="flex items-start gap-3.5 border-b border-[#f0e6ea] py-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] bg-sand text-[#5b4636]">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
            </span>
            <div><dt class="text-[13px] text-[#6b5d52]">{t(locale, 'contact.email')}</dt><dd class="m-0"><a href={`mailto:${CONTACT.email}`} class="sl-tlink font-medium text-gray-900">{CONTACT.email}</a></dd></div>
          </div>
        </dl>
        <a href={directions} target="_blank" rel="noopener" class="sl-lift relative mt-1.5 block h-[200px] max-w-[500px] overflow-hidden rounded-2xl border border-[#ece3d9]" aria-label={t(locale, 'contact.getDirections')}>
          <OptimizedPicture src="@assets/misc/showroom-map.webp" alt={a('mapAlt')} widths={[480, 640, 980]} sizes="500px" class="block h-full w-full object-cover" />
          <span class="absolute right-2 bottom-1.5 rounded bg-white/85 px-1.5 text-[10px] text-gray-600">© OpenStreetMap</span>
        </a>
        <div class="mt-2 grid w-full max-w-[500px] grid-cols-2 gap-2.5">
          <a href={consultHref} class="sl-btn sl-btn-pink px-2.5">{a('visitCta')}</a>
          <a href={directions} target="_blank" rel="noopener" class="sl-btn sl-btn-plum px-2.5"><ShowcaseIcon name="pin" size={16} />{t(locale, 'contact.getDirections')}</a>
        </div>
      </div>
      <picture>
        <source type="image/avif" srcset="/hero/hero-skinlab-showroom-foto.avif" />
        <source type="image/webp" srcset="/hero/hero-skinlab-showroom-foto.webp" />
        <img src="/hero/hero-skinlab-showroom-foto.jpg" alt={a('showroomAlt')} width="1434" height="1024" loading="lazy" class="block h-auto w-full" />
      </picture>
    </div>
  </section>
</BaseLayout>
