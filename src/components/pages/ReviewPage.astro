---
/**
 * ReviewPage - "Értékelj minket" oldal (/ertekeles/), amit az ügyfeleknek
 * küldünk ki (link a láblécben is).
 *
 * 1. Fő út: Google-értékelés írása (GOOGLE_REVIEW_URL, új lapon).
 * 2. Alternatíva: vélemény közvetlenül nekünk – szövegesen vagy videóval
 *    (/api/review, e-mailben érkezik a csapathoz). A videó max. 25 MB
 *    mellékletként; nagyobbhoz link vagy WhatsApp.
 * Csak magyarul, noindex (nem keresőből érkeznek ide, hanem a kiküldött linkről).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ContentImage } from '../images';
import { CONTACT, GOOGLE_RATING, GOOGLE_REVIEW_URL } from '../../lib/constants';
import { getTurnstileSiteKey } from '../../lib/forms/turnstile';

const turnstileSiteKey = getTurnstileSiteKey();
const rating = GOOGLE_RATING ? GOOGLE_RATING.value.toFixed(1).replace('.', ',') : null;
const whatsappUrl = `https://wa.me/${CONTACT.phone.replace('+', '')}?text=${encodeURIComponent('Szia! Küldöm a videós véleményemet a Skinlabról.')}`;
const star = 'M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69z';
const inputCls = 'w-full px-4 py-3 border border-gray-300 bg-white focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors';
---

<BaseLayout
  title="Értékeld a Skinlabot | Skinlab Hungary"
  description="Köszönjük, hogy velünk dolgozol! Írd meg a véleményed a Google-ön, vagy küldd el nekünk szövegesen vagy videóban."
  noIndex={true}
>
  <section class="bg-[#fbf3f2]">
    <div class="grid lg:grid-cols-2">
      <div class="relative aspect-[4/3] lg:aspect-auto lg:min-h-[560px] overflow-hidden">
        <ContentImage
          src="@assets/skinlab-csapat-milano.jpg"
          alt="A Skinlab csapata közös szelfin Milánóban"
          class="absolute inset-0 w-full h-full object-cover object-[center_35%]"
          priority
        />
      </div>
      <div class="flex flex-col justify-center px-4 sm:px-8 py-10 lg:py-16 lg:pl-16 lg:pr-[max(2rem,calc((100vw-80rem)/2+2rem))]">
        <p class="text-sm font-bold tracking-[0.12em] uppercase text-primary-700 mb-3">Köszönjük, hogy velünk dolgozol</p>
        <h1 class="font-heading font-normal text-[2rem] leading-[1.12] lg:text-[3rem] text-gray-900 mb-4">
          Mondd el, milyen <em class="text-primary-700">velünk dolgozni</em>
        </h1>
        <p class="text-[17px] lg:text-[19px] leading-relaxed text-gray-700 mb-8 max-w-[34rem]">
          Neked egy perc, a többi kozmetikusnak sokat segít: a véleményedből látják, hogy ránk bízhatják a szalonjukat. És nekünk is jólesik.
        </p>

        <div class="bg-white p-5 sm:p-6 shadow-sm max-w-[34rem]">
          <div class="flex items-center gap-3 mb-4">
            <svg class="w-10 h-10 shrink-0" viewBox="0 0 48 48" role="img" aria-label="Google"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>
            <div>
              <p class="font-bold text-gray-900 text-lg leading-tight">Értékelj minket a Google-ön</p>
              {rating && <p class="text-sm text-gray-600">Jelenleg {rating} csillag a Google-ön</p>}
            </div>
          </div>
          <a
            href={GOOGLE_REVIEW_URL}
            target="_blank"
            rel="noopener"
            data-event="review_google_click"
            class="flex items-center justify-center gap-2 min-h-[3.5rem] px-6 bg-primary-700 text-white font-semibold text-[17px] hover:bg-primary-800 active:scale-[0.98] transition-all"
          >
            <span class="flex text-amber-300" aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor"><path d={star} /></svg>)}
            </span>
            Értékelés írása a Google-ön
          </a>
          <p class="mt-3 text-sm text-gray-600">Pár mondat is elég: melyik gépet használod, és mit szeretsz benne?</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 lg:py-20" id="velemeny-kuldese">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-heading font-normal text-[1.75rem] lg:text-[2.4rem] leading-[1.15] text-gray-900 mb-3">
        Inkább nekünk írnád meg, <em class="text-primary-700">vagy videóban mondanád el?</em>
      </h2>
      <p class="text-base lg:text-lg text-gray-700 mb-8">
        Egy rövid videó a legértékesebb: 30–60 másodperc is elég. Mondd el, ki vagy, melyik gépünkkel dolgozol, és mit szeretsz benne. Telefonnal, álló formátumban felvéve tökéletes.
      </p>

      <form id="review-form" class="space-y-5" novalidate enctype="multipart/form-data">
        <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="rv-name" class="block text-sm font-semibold text-gray-800 mb-1.5">Neved *</label>
            <input id="rv-name" name="name" required autocomplete="name" class={inputCls} />
          </div>
          <div>
            <label for="rv-salon" class="block text-sm font-semibold text-gray-800 mb-1.5">Szalonod neve</label>
            <input id="rv-salon" name="salon" autocomplete="organization" class={inputCls} />
          </div>
        </div>
        <div>
          <label for="rv-email" class="block text-sm font-semibold text-gray-800 mb-1.5">E-mail-címed (ha válaszolnánk)</label>
          <input id="rv-email" name="email" type="email" autocomplete="email" class={inputCls} />
        </div>

        <fieldset>
          <legend class="block text-sm font-semibold text-gray-800 mb-1.5">Hány csillagot adnál?</legend>
          <div class="rv-stars flex flex-row-reverse justify-end gap-1">
            {[5, 4, 3, 2, 1].map((n) => (
              <>
                <input type="radio" name="rating" value={n} id={`rv-star-${n}`} class="sr-only peer" checked={n === 5} />
                <label for={`rv-star-${n}`} class="cursor-pointer p-1 text-gray-300" title={`${n} csillag`}>
                  <svg class="w-9 h-9" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d={star} /></svg>
                  <span class="sr-only">{n} csillag</span>
                </label>
              </>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="rv-message" class="block text-sm font-semibold text-gray-800 mb-1.5">Véleményed</label>
          <textarea id="rv-message" name="message" rows="5" class={`${inputCls} resize-y`} placeholder="Melyik gépet használod? Hogy ment a betanítás? Mit mondanál egy kolléganődnek?"></textarea>
        </div>

        <div class="border border-dashed border-primary-300 bg-primary-50/50 p-4 sm:p-5">
          <label for="rv-video" class="block text-sm font-semibold text-gray-800 mb-1.5">Videós vélemény (nem kötelező, max. 25 MB)</label>
          <input id="rv-video" name="video" type="file" accept="video/*" class="block w-full text-sm text-gray-700 file:mr-3 file:min-h-11 file:px-4 file:border-0 file:bg-primary-700 file:text-white file:font-semibold hover:file:bg-primary-800" />
          <p class="mt-2 text-sm text-gray-600" data-video-info></p>
          <p class="mt-3 text-sm text-gray-700">Nagyobb a videód? Add meg a linkjét (Google Drive, WeTransfer), vagy küldd el WhatsAppon:</p>
          <div class="mt-2 flex flex-col sm:flex-row gap-2">
            <input name="videoLink" type="url" inputmode="url" placeholder="https://…" aria-label="Videó linkje" class={`${inputCls} sm:flex-1`} />
            <a href={whatsappUrl} target="_blank" rel="noopener" data-event="review_whatsapp_click" class="inline-flex items-center justify-center gap-2 min-h-12 px-5 bg-[#25d366] text-white font-semibold hover:bg-[#1ebe5b]">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 21.8h-.01a9.8 9.8 0 01-5-1.37l-.36-.21-3.72.97 1-3.62-.24-.37a9.78 9.78 0 01-1.5-5.22c0-5.41 4.41-9.82 9.83-9.82a9.75 9.75 0 016.95 2.88 9.75 9.75 0 012.87 6.95c0 5.42-4.4 9.81-9.82 9.81zm8.36-18.17A11.75 11.75 0 0012.04.2C5.5.2.2 5.5.2 12.03c0 2.09.55 4.12 1.59 5.92L.1 24l6.2-1.62a11.8 11.8 0 005.73 1.46h.01c6.53 0 11.84-5.3 11.84-11.83 0-3.16-1.23-6.13-3.47-8.37z"/></svg>
              WhatsApp
            </a>
          </div>
        </div>

        <label class="flex items-start gap-3 text-[15px] text-gray-700">
          <input type="checkbox" name="publishConsent" value="true" class="mt-1 w-5 h-5 shrink-0 accent-[#ce2252]" />
          <span>Hozzájárulok, hogy a véleményemet (és a videómat) a nevemmel megjelenítsétek a weboldalon és a közösségi oldalaitokon.</span>
        </label>
        <label class="flex items-start gap-3 text-[15px] text-gray-700">
          <input type="checkbox" name="gdprConsent" value="true" required class="mt-1 w-5 h-5 shrink-0 accent-[#ce2252]" />
          <span>Elolvastam és elfogadom az <a href="/adatvedelem/" class="text-primary-700 underline" target="_blank">adatkezelési tájékoztatót</a>. *</span>
        </label>

        {turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
        )}

        <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center min-h-[3.5rem] px-8 bg-primary-700 text-white font-semibold text-[17px] hover:bg-primary-800 disabled:opacity-60 transition-colors" data-submit>
          Vélemény elküldése
        </button>
        <p class="hidden p-4 bg-red-50 border border-red-200 text-red-800" role="alert" data-error></p>
      </form>

      <div class="hidden p-6 bg-emerald-50 border border-emerald-200" role="status" data-success>
        <p class="font-heading text-2xl text-gray-900 mb-2">Köszönjük, megkaptuk!</p>
        <p class="text-gray-700">Nagyon jólesik, hogy időt szántál ránk. Ha még nem tetted, a Google-ön is <a href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener" class="text-primary-700 underline font-semibold">értékelhetsz minket</a> – ott látják a legtöbben.</p>
      </div>
    </div>
  </section>

  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>

<style>
  /* Csillagválasztó: a kijelölt és az előtte lévők (fordított sorrend miatt utána lévők) aranyak. */
  .rv-stars input:checked ~ label,
  .rv-stars label:hover,
  .rv-stars label:hover ~ label { color: #f59e0b; }
  .rv-stars input:focus-visible + label { outline: 2px solid #ce2252; outline-offset: 2px; }
</style>

<script>
  const MAX = 25 * 1024 * 1024;
  const form = document.getElementById('review-form') as HTMLFormElement | null;
  const video = form?.querySelector<HTMLInputElement>('#rv-video');
  const info = form?.querySelector<HTMLElement>('[data-video-info]');
  const errorBox = form?.querySelector<HTMLElement>('[data-error]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const success = document.querySelector<HTMLElement>('[data-success]');

  const showError = (msg: string) => {
    if (!errorBox) return;
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  };

  video?.addEventListener('change', () => {
    const f = video.files?.[0];
    if (!info) return;
    if (!f) { info.textContent = ''; return; }
    const mb = (f.size / 1048576).toFixed(1);
    info.textContent = f.size > MAX
      ? `${mb} MB – ez túl nagy a feltöltéshez. Add meg linkként, vagy küldd el WhatsAppon.`
      : `Kiválasztva: ${f.name} (${mb} MB)`;
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox?.classList.add('hidden');
    const data = new FormData(form);
    const f = video?.files?.[0];
    if (f && f.size > MAX) { showError('A videó túl nagy (max. 25 MB). Add meg linkként, vagy küldd el WhatsAppon.'); return; }
    if (!f) data.delete('video');
    if (String(data.get('name') ?? '').trim().length < 2) { showError('Kérjük, add meg a neved.'); return; }
    if (!data.get('gdprConsent')) { showError('Az adatkezelési tájékoztató elfogadása kötelező.'); return; }
    if (!String(data.get('message') ?? '').trim() && !f && !String(data.get('videoLink') ?? '').trim()) {
      showError('Írj pár sort, vagy csatolj videót.');
      return;
    }
    if (submit) { submit.disabled = true; submit.textContent = f ? 'Videó feltöltése…' : 'Küldés…'; }
    try {
      const res = await fetch('/api/review', { method: 'POST', body: data });
      const body = await res.json().catch(() => ({}));
      if (!res.ok || !body.success) {
        showError(body.error || 'Nem sikerült elküldeni. Kérjük, próbáld újra.');
        (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
        return;
      }
      form.classList.add('hidden');
      success?.classList.remove('hidden');
      (window as unknown as { dataLayer?: Record<string, unknown>[] }).dataLayer?.push({ event: 'review_submit', has_video: Boolean(f || data.get('videoLink')) });
    } catch {
      showError('Hálózati hiba történt. Kérjük, próbáld újra.');
    } finally {
      if (submit) { submit.disabled = false; submit.textContent = 'Vélemény elküldése'; }
    }
  });
</script>
