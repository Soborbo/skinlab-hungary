---
/**
 * ProductHero - Product hero section.
 *
 * Layout: image gallery on the LEFT, product info on the RIGHT (desktop).
 * On mobile the gallery stacks on top, info below.
 *
 * The hero gallery shows the main image plus all gallery images as a carousel
 * with thumbnails below it. Trust/USP badges live in the USPStrip, and
 * installment info in the InstallmentCalculator section.
 */
import ProductGallery from './ProductGallery.astro';
import AddToCartButton from '../cart/AddToCartButton.astro';
import { CONTACT } from '@/lib/constants';
import type { Locale } from '@/i18n';
import { t, getLocalizedUrl, formatPrice } from '@/i18n';

interface VariantImageSet {
  value: string;
  images: string[];
}

interface Variant {
  sku: string;
  name: string;
  value: string;
  price: number | null;
  image?: string;
  images?: string[];
  available?: boolean;
}

interface Props {
  locale: Locale;
  slug: string;
  name: string;
  sku: string;
  shortDescription?: string;
  description?: string;
  price: number | null;
  salePrice?: number | null;
  image: string;
  gallery: string[];
  designImages?: string[];
  availability: 'in_stock' | 'preorder' | 'out_of_stock';
  hasVariants: boolean;
  variants: Variant[];
  featured?: boolean;
  categorySlug: string;
  variantImageSets?: VariantImageSet[];
  /**
   * Részletfizetési sor az ár alatt (előleg + futamidő × havi összeg), linkkel
   * a pénzügyi kalkulátorra (#kalkulator). A layout csak akkor adja át, ha a
   * kalkulátor is megjelenik, így az anchor sosem lóg.
   */
  installment?: { downPayment: number; months: number; monthly: number };
  /** Hero galéria megjelenés: kitöltő négyzetes keret + automatikus lapozás. */
  hero?: { fill?: boolean; autoplayMs?: number };
}

const {
  locale,
  slug,
  name,
  sku,
  shortDescription,
  description,
  price,
  salePrice,
  image,
  gallery,
  designImages,
  availability,
  hasVariants,
  variants,
  featured,
  categorySlug,
  variantImageSets,
  installment,
  hero,
} = Astro.props;

// Format price with locale
const displayPrice = (p: number | null) => {
  if (!p) return null;
  return formatPrice(p, locale);
};

// Hero gallery: design photos FIRST, then the main image + gallery (deduped) →
// carousel with thumbnails. Variant products keep per-variant switching via
// variantImageSets (ProductGallery ignores `images` in variant mode).
//
// A design fotók szándékosan NEM a `image` mezőből jönnek: a főkép fehér
// hátteres marad (mega-menü thumbnail szabály + Merchant Center feed), csak a
// galéria ELEJÉN előzik meg. Ezért a megjelenési sorrend eltér a slug-sorrendtől.
const heroImages = [...new Set([...(designImages ?? []), image, ...(gallery ?? [])])].filter(Boolean);
---

<section class="bg-white py-6 lg:py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 lg:items-start">

      <!-- Product Info (right on desktop, below on mobile) -->
      <div class="order-2">
        <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {name}
        </h1>

        <p class="text-lg text-gray-600 mb-6">
          {shortDescription || description?.slice(0, 200)}
        </p>

        <!-- Variants (if any) -->
        {hasVariants && variants.length > 0 && (
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">
              {t(locale, 'product.selectVariant')}
            </label>
            <div class="flex flex-wrap gap-2">
              {variants.map((variant, i) => (
                <button
                  type="button"
                  class={`px-4 py-2 rounded-lg border-2 text-sm font-medium transition-all ${
                    i === 0
                      ? 'border-primary-600 bg-primary-50 text-primary-700'
                      : 'border-gray-200 hover:border-primary-300 text-gray-700'
                  }`}
                  data-variant={variant.sku}
                  data-variant-value={variant.value}
                  data-variant-image={variant.image}
                  data-variant-price={displayPrice(variant.price ?? price)}
                >
                  {variant.name}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Price -->
        <div class="mb-6">
          {price ? (
            <>
              {salePrice ? (
                <div class="flex items-baseline gap-3">
                  <div class="text-3xl font-bold text-red-600" data-price-display>{displayPrice(salePrice)}</div>
                  <div class="text-xl text-gray-400 line-through">{displayPrice(price)}</div>
                </div>
              ) : (
                <div class="text-3xl font-bold text-gray-900" data-price-display>{displayPrice(price)}</div>
              )}
              <div class="text-sm text-gray-500 mt-1">{t(locale, 'product.grossPrice')}</div>
              {installment && (
                <div class="mt-3 text-base text-gray-900">
                  {t(locale, 'product.installmentLinePre')}{' '}
                  <strong>{t(locale, 'product.installmentLine', {
                    down: formatPrice(installment.downPayment, locale),
                    months: installment.months,
                    monthly: formatPrice(installment.monthly, locale),
                  })}</strong>
                  {' · '}
                  <a href="#kalkulator" data-open-installment class="font-semibold text-primary-700 hover:text-primary-800 underline-offset-2 hover:underline">{t(locale, 'product.installmentCalc')}</a>
                </div>
              )}
            </>
          ) : (
            <div class="text-2xl font-bold text-primary-600">{t(locale, 'product.priceOnRequest')}</div>
          )}
        </div>

        <!-- Add to cart -->
        <div class="mb-4">
          <AddToCartButton
            locale={locale}
            slug={slug}
            sku={sku}
            name={name}
            categorySlug={categorySlug}
            image={image}
            price={salePrice ?? price}
            availability={availability}
            hasVariants={hasVariants}
            variants={variants}
          />
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={getLocalizedUrl(locale, '/konzultacio')}
            class="flex-1 inline-flex items-center justify-center px-6 py-4 bg-primary-50 text-primary-700 font-semibold rounded-xl hover:bg-primary-100 transition-colors"
          >
            {t(locale, 'product.freeConsultation')}
          </a>
          <a
            href={CONTACT.phoneTel}
            class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-4 bg-success-50 text-success-700 font-semibold rounded-xl hover:bg-success-100 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {t(locale, 'product.callNow')}
          </a>
        </div>

        <!-- SKU -->
        <div class="mt-6 text-xs text-gray-400">
          {t(locale, 'product.sku')}: {sku}
        </div>
      </div>

      <!-- Image gallery (left on desktop, top on mobile) -->
      <div class="order-1">
        <ProductGallery
          images={heroImages}
          productName={name}
          badges={{
            featured: featured,
            variantCount: hasVariants ? variants.length : undefined
          }}
          variantImageSets={variantImageSets}
          thumbnails={false}
          fill={hero?.fill}
          autoplayMs={hero?.autoplayMs}
        />
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Variánsválasztás.
   *
   * A megjelenített ár is követi a választást: az AddToCartButton eddig is a
   * variáns árát tette a kosárba, a hero viszont mindig az alaptermék árát
   * mutatta - eltérő árú variánsoknál (pl. 50 ml / 150 ml) ez azt jelentette,
   * hogy a vevő 12 990 Ft-ot látott, és 20 990 Ft került a kosárba. Ez a
   * Merchant Center feed variánssorainál is azonnali "ár eltérés" elutasítás
   * lenne, mert a Google a feed árát a landoló oldalon látható árral veti össze.
   *
   * A `?v=<sku>` query paraméter előre kiválasztja a variánst - a feed
   * variánssorai erre a formára mutatnak.
   */
  function selectVariant(btn: Element) {
    document.querySelectorAll('[data-variant]').forEach(b => {
      b.classList.remove('border-primary-600', 'bg-primary-50', 'text-primary-700');
      b.classList.add('border-gray-200', 'text-gray-700');
    });
    btn.classList.remove('border-gray-200', 'text-gray-700');
    btn.classList.add('border-primary-600', 'bg-primary-50', 'text-primary-700');

    // Ár frissítése (csak ha a variánshoz tartozik kiírható ár)
    const priceLabel = btn.getAttribute('data-variant-price');
    const priceEl = document.querySelector<HTMLElement>('[data-price-display]');
    if (priceLabel && priceEl) priceEl.textContent = priceLabel;

    // Galéria- és kosárváltás
    const variantValue = btn.getAttribute('data-variant-value');
    if (variantValue) {
      document.dispatchEvent(new CustomEvent('variant-change', {
        detail: { value: variantValue }
      }));
    }
  }

  function initVariants() {
    const buttons = document.querySelectorAll('[data-variant]');
    if (buttons.length === 0) return;

    buttons.forEach(btn => btn.addEventListener('click', () => selectVariant(btn)));

    // Mélylinkelt variáns (?v=SKU). Az elsőt nem kell újraválasztani, az már
    // szerveroldalon aktív.
    const wanted = new URLSearchParams(window.location.search).get('v');
    if (!wanted) return;
    const target = document.querySelector(`[data-variant="${CSS.escape(wanted)}"]`);
    if (target && target !== buttons[0]) selectVariant(target);
  }

  // A galéria és a kosár gomb ugyanígy modul-scriptben köti be a
  // `variant-change` figyelőjét; a modulok a DOMContentLoaded ELŐTT futnak le,
  // így itt már biztosan hallják az induló eseményt.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVariants, { once: true });
  } else {
    initVariants();
  }
</script>
