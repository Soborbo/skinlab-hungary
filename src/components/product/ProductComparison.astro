---
/**
 * ProductComparison - az aktuális termék és kategória-testvérei egymás mellett.
 *
 * Az adatot a layout számolja (lib/product-comparison.ts → buildComparison),
 * így ott dől el az is, kell-e mellé a RelatedProducts blokk.
 */
import type { Locale } from '@/i18n';
import { t } from '@/i18n';
import OptimizedPicture from '../images/OptimizedPicture.astro';
import type { ComparisonTable } from '@/lib/product-comparison';

interface Props {
  locale: Locale;
  table: ComparisonTable;
  /** Felülírások a főoldali használathoz (alapból a termékoldali szövegek). */
  title?: string;
  subtitle?: string;
  /** A kiemelt oszlop címkéje; ha meg van adva, az oszlop nem "ez az oldal". */
  highlightLabel?: string;
  /** Mobilon a táblázat fölött: jelzi, hogy oldalra görgethető. */
  scrollHint?: string;
  sectionClass?: string;
  /**
   * Ennyi sor látszik alapból; a többi egy gombbal nyílik. Ilyenkor a sorok a
   * legtöbb eltérő értéket mutatóval kezdődnek (a legtöbbet mondó különbség elöl).
   */
  maxRows?: number;
  showAllLabel?: string;
  showLessLabel?: string;
}

const {
  locale,
  table,
  title = t(locale, 'productComparison.title'),
  subtitle = t(locale, 'productComparison.subtitle'),
  highlightLabel,
  scrollHint,
  sectionClass = 'py-12 lg:py-16 bg-gray-50',
  maxRows,
  showAllLabel,
  showLessLabel,
} = Astro.props;
const { columns } = table;
const distinct = (values: string[]) => new Set(values.filter(Boolean)).size;
const rows = maxRows
  ? [...table.rows].sort((a, b) => distinct(b.values) - distinct(a.values))
  : table.rows;
const hiddenCount = maxRows ? Math.max(0, rows.length - maxRows) : 0;
const cellTone = (isCurrent: boolean) => (isCurrent ? 'bg-primary-50 border-primary-100' : 'border-gray-100');
---

<section class={sectionClass}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-2">{title}</h2>
      <p class="text-gray-600">{subtitle}</p>
    </div>

    {scrollHint && (
      <p class="sm:hidden -mt-4 mb-3 flex items-center gap-1.5 text-xs font-medium text-gray-500">
        {scrollHint}
        <svg class="comparison-nudge w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" /></svg>
      </p>
    )}

    <div class="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
      <table class="w-full min-w-[640px] table-fixed border-separate border-spacing-0 rounded-2xl border border-gray-200 bg-white text-left">
        <thead>
          <tr>
            <td class="w-40 lg:w-52"></td>
            {columns.map((col) => (
              <th scope="col" class:list={['p-4 lg:p-6 align-top text-center font-normal', col.isCurrent && 'bg-primary-50 border-t-4 border-primary-500']}>
                <a href={col.href} class="group flex flex-col items-center gap-3" aria-current={col.isCurrent && !highlightLabel ? 'page' : undefined} data-event={highlightLabel ? 'home_comparison_click' : undefined}>
                  <OptimizedPicture
                    src={col.image}
                    alt={col.name}
                    widths={[160, 320]}
                    sizes="140px"
                    class="w-24 h-24 lg:w-32 lg:h-32 object-contain"
                    loading="lazy"
                  />
                  <span class="font-bold text-gray-900 leading-tight group-hover:text-primary-700">{col.name}</span>
                  {col.isCurrent ? (
                    <span class="text-xs font-bold text-primary-700">{highlightLabel ?? t(locale, 'productComparison.current')}</span>
                  ) : (
                    <span class="text-sm font-semibold text-primary-700">{t(locale, 'productComparison.view')} →</span>
                  )}
                </a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" class="border-t border-gray-100 p-4 lg:px-6 text-sm font-medium text-gray-600">{t(locale, 'productComparison.price')}</th>
            {columns.map((col) => (
              <td class:list={['border-t p-4 lg:px-6 text-center font-extrabold text-gray-900', cellTone(col.isCurrent)]}>{col.price}</td>
            ))}
          </tr>
          {rows.map((row, rowIndex) => (
            <tr data-extra-row={maxRows && rowIndex >= maxRows ? '' : undefined} class:list={[maxRows && rowIndex >= maxRows && 'hidden']}>
              <th scope="row" class="border-t border-gray-100 p-4 lg:px-6 text-sm font-medium text-gray-600">{row.key}</th>
              {row.values.map((value, i) => (
                <td class:list={['border-t p-4 lg:px-6 text-center text-sm text-gray-900', cellTone(columns[i].isCurrent)]}>
                  {value || '–'}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {hiddenCount > 0 && showAllLabel && (
      <div class="mt-4 text-center">
        <button
          type="button"
          data-comparison-toggle
          aria-expanded="false"
          data-label-more={showAllLabel}
          data-label-less={showLessLabel ?? showAllLabel}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-primary-700/30 text-primary-700 font-semibold text-sm hover:bg-primary-50 active:scale-[0.98] transition-all cursor-pointer"
        >
          <span data-comparison-label>{showAllLabel}</span>
          <svg class="w-4 h-4 transition-transform duration-300" data-comparison-icon fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
      </div>
    )}
  </div>
</section>

<style>
  .comparison-nudge {
    animation: comparison-nudge 1.6s ease-in-out 3;
  }
  @keyframes comparison-nudge {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .comparison-nudge { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-comparison-toggle]').forEach((button) => {
    const section = button.closest('section');
    const label = button.querySelector<HTMLElement>('[data-comparison-label]');
    const icon = button.querySelector<HTMLElement>('[data-comparison-icon]');
    button.addEventListener('click', () => {
      const expand = button.getAttribute('aria-expanded') !== 'true';
      section?.querySelectorAll('[data-extra-row]').forEach((row) => row.classList.toggle('hidden', !expand));
      button.setAttribute('aria-expanded', String(expand));
      if (label) label.textContent = (expand ? button.dataset.labelLess : button.dataset.labelMore) ?? '';
      icon?.classList.toggle('rotate-180', expand);
    });
  });
</script>
