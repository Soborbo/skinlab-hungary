---
/**
 * VideoDescription - YouTube video + description side-by-side section
 *
 * Two-column layout: YouTube facade (left) + heading + paragraphs (right).
 * The video uses the shared click-to-load VideoFacade.
 */

import type { Locale } from '@/i18n';
import { t } from '@/i18n';
import type { ProductContentVideoDescription, ProductContentStat } from '@/lib/types/product-content';
import VideoFacade from '../video/VideoFacade.astro';
import OptimizedPicture from '../images/OptimizedPicture.astro';
import { hasImage } from '@/lib/resolve-image';

interface Props {
  locale: Locale;
  videoUrl?: string;
  productName: string;
  content: ProductContentVideoDescription;
  /** Videó hiányában ez a fotó jelenik meg a "videó hamarosan" doboz helyett. */
  fallbackImage?: string;
  /** Kulcsszámok a szöveg alatt (max. 3 jelenik meg). */
  stats?: ProductContentStat[];
}

const { locale, videoUrl, productName, content, fallbackImage, stats = [] } = Astro.props;
const shownStats = stats.slice(0, 3);

// Extract YouTube video ID
const getVideoId = (url: string): string | null => {
  const patterns = [
    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/,
    /^([a-zA-Z0-9_-]{11})$/,
  ];
  for (const pattern of patterns) {
    const match = url.match(pattern);
    if (match) return match[1];
  }
  return null;
};

const videoId = videoUrl ? getVideoId(videoUrl) : null;
const photo = !videoId && fallbackImage && hasImage(fallbackImage) ? fallbackImage : null;
---

<section class="py-12 lg:py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Left: Video -->
      <div class:list={[
        'relative rounded-2xl overflow-hidden shadow-lg',
        photo ? 'aspect-square bg-gray-100' : 'aspect-video bg-gray-900',
      ]}>
        {photo ? (
          <OptimizedPicture
            src={photo}
            alt={productName}
            widths={[480, 640, 828, 1080]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        ) : videoId ? (
          <VideoFacade
            videoId={videoId}
            title={`${productName} ${t(locale, 'product.videoDemo')}`}
            alt={t(locale, 'product.videoPlayLabel', { title: productName })}
            playLabel={t(locale, 'product.videoPlayLabel', { title: productName })}
            poster="landscape"
            playSize="lg"
            class="w-full h-full"
          />
        ) : (
          <div class="w-full h-full bg-gradient-to-br from-primary-100 to-primary-200 flex items-center justify-center">
            <div class="text-center p-8">
              <svg class="w-16 h-16 text-primary-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <p class="text-sm text-primary-400">{t(locale, 'product.videoPlaceholder')}</p>
            </div>
          </div>
        )}
      </div>

      <!-- Right: Description -->
      <div>
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-6">
          {content.headline}
        </h2>
        <div class="space-y-4 text-gray-600 leading-relaxed">
          {content.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        {shownStats.length > 0 && (
          <dl class="mt-8 grid grid-cols-3 gap-4">
            {shownStats.map((stat) => (
              <div class="border-t-2 border-primary-500 pt-3">
                <dt class="sr-only">{stat.label}</dt>
                <dd class="text-2xl lg:text-3xl font-extrabold text-gray-900 leading-none">
                  {stat.value}{stat.unit && <span class="text-lg lg:text-xl font-bold">{stat.unit}</span>}
                </dd>
                <dd class="mt-1.5 text-sm text-gray-600 leading-snug" aria-hidden="true">{stat.label}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </div>
  </div>
</section>
