---
/**
 * Előtte/utána húzogatós összehasonlítás (minta: exquisite-laser BeforeAfterSlider).
 * Natív range input: egér, érintés, billentyűzet és képernyőolvasó a böngészőtől.
 * A két fotó azonos szögű és arányú legyen; `arany` = CSS aspect-ratio (pl. "4 / 5").
 */
import { t, getLocaleFromUrl, type Locale } from '@/i18n/ui';

interface Props {
  elotte: string;
  utana: string;
  alt: string;
  arany?: string;
  felirat?: string;
}

const { elotte, utana, alt, arany = '4 / 5', felirat } = Astro.props;
const locale = getLocaleFromUrl(Astro.url) as Locale;
const before = t(locale, 'blogPost.before');
const after = t(locale, 'blogPost.after');
---

<figure class="blog-media not-prose">
  <div class="bas" style={`--pos:50%;aspect-ratio:${arany}`} data-bas>
    <img class="bas-img" src={elotte} alt={`${alt} (${before})`} loading="lazy" decoding="async" />
    <img class="bas-img bas-after" src={utana} alt={`${alt} (${after})`} loading="lazy" decoding="async" />
    <span class="bas-tag bas-tag-a" aria-hidden="true">{after}</span>
    <span class="bas-tag bas-tag-b" aria-hidden="true">{before}</span>
    <span class="bas-line" aria-hidden="true"><span class="bas-knob"></span></span>
    <input class="bas-range" type="range" min="0" max="100" value="50" step="1" aria-label={t(locale, 'blogPost.compareLabel')} data-before={before} data-after={after} />
  </div>
  {felirat && <figcaption>{felirat}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-bas]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('.bas-range');
    if (!input) return;
    const sync = () => {
      const v = Number(input.value);
      root.style.setProperty('--pos', `${v}%`);
      input.setAttribute('aria-valuetext', v <= 0 ? input.dataset.before ?? '' : v >= 100 ? input.dataset.after ?? '' : `${v}% ${input.dataset.after}`);
    };
    input.addEventListener('input', sync);
    sync();
  });
</script>

<style>
  .bas { position: relative; overflow: hidden; touch-action: pan-y; background: var(--color-sand); user-select: none; border-radius: 3px; }
  .bas-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .bas-after { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .bas-tag { position: absolute; top: 12px; background: var(--color-plum); color: #fff; font-size: 13px; padding: 5px 10px; border-radius: 3px; pointer-events: none; }
  .bas-tag-a { left: 12px; }
  .bas-tag-b { right: 12px; }
  .bas-line { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff; pointer-events: none; }
  .bas-knob { position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; margin: -22px 0 0 -22px; border-radius: 50%; background: #fff; box-shadow: 0 4px 14px rgb(31 20 24 / .3); transition: transform .2s ease; }
  .bas-knob::before, .bas-knob::after { content: ''; position: absolute; top: 50%; width: 7px; height: 7px; border: solid var(--color-primary-700); border-width: 0 0 2px 2px; }
  .bas-knob::before { left: 11px; transform: translateY(-50%) rotate(45deg); }
  .bas-knob::after { right: 11px; transform: translateY(-50%) rotate(-135deg); }
  .bas:hover .bas-knob, .bas:has(.bas-range:active) .bas-knob { transform: scale(1.08); }
  .bas-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .bas:has(.bas-range:focus-visible) .bas-knob { outline: 3px solid #fff; outline-offset: 3px; box-shadow: 0 0 0 6px var(--color-primary-700); }
  @media (prefers-reduced-motion: reduce) {
    .bas-knob { transition: none; }
    .bas:hover .bas-knob { transform: none; }
  }
</style>
