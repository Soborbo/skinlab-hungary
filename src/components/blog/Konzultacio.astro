---
/**
 * Cikkbeli CTA-sáv: ingyenes konzultáció + telefon. Opcionális saját cím
 * (`cim`), különben az általános szöveg.
 */
import { CONTACT } from '@/lib/constants';
import { t, getLocaleFromUrl, getLocalizedUrl, type Locale } from '@/i18n/ui';

interface Props {
  cim?: string;
}

const locale = getLocaleFromUrl(Astro.url) as Locale;
const { cim = t(locale, 'blogPost.ctaTitle') } = Astro.props;
---

<aside class="blog-cta not-prose">
  <p class="text-xl font-semibold text-plum leading-snug">{cim}</p>
  <p class="text-gray-700 mt-2">{t(locale, 'blogPost.ctaText')}</p>
  <div class="mt-5 grid gap-3 sm:grid-cols-2">
    <a href={getLocalizedUrl(locale, '/konzultacio/')} class="sl-btn sl-btn-pink" data-event="blog_cta_consult">{t(locale, 'header.freeConsultation')}</a>
    <a href={CONTACT.phoneTel} class="sl-btn sl-btn-plum" data-event="blog_cta_call">{CONTACT.phoneDisplay}</a>
  </div>
</aside>
