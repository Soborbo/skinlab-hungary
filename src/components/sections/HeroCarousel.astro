---
import { CONTACT } from '../../lib/constants';
import { t, getLocaleFromUrl, getLocalizedUrl, type Locale } from '../../i18n/ui';

const locale = getLocaleFromUrl(Astro.url) as Locale;
const contactLink = getLocalizedUrl(locale, '/konzultacio');

// Őszi fejlécképek (2026-09-17). A forrás 1920x670-es szalagkép: a valódi fotó
// csak a középső ~1000 px, két oldalt elmosott kitöltés. Ezért asztalon NEM
// háttérként használjuk (a szövegpanel vagy a kitöltést, vagy a gépet takarná),
// hanem a valódi fotó 3:2-es kivágását (`*-foto.*`) a saját oszlopában, és a
// szöveg tiszta háttéren áll mellette. Mobilon a külön 1080x1080-as vágás megy.
// Sorrend: az EMPIRE elöl (felhasználói szabály), a dia szövege a képhez illik.
const slides = [
  {
    titleKey: 'hero.slide7.title',
    subtitleKey: 'hero.slide7.subtitle',
    shortKey: 'homeHero.slides.empire',
    image: '/hero/hero-empire-4wave-diodalezer-foto',
    mobile: '/hero/hero-empire-4wave-diodalezer-mobile',
  },
  {
    titleKey: 'hero.title',
    subtitleKey: 'hero.subtitle',
    shortKey: 'homeHero.slides.olympia',
    image: '/hero/hero-olympia-diodalezer-osz-foto',
    mobile: '/hero/hero-olympia-diodalezer-osz-mobile',
  },
  {
    titleKey: 'hero.slide4.title',
    subtitleKey: 'hero.slide4.subtitle',
    shortKey: 'homeHero.slides.ndyag',
    image: '/hero/hero-nd-yag-lezer-osz-foto',
    mobile: '/hero/hero-nd-yag-lezer-osz-mobile',
  },
  {
    titleKey: 'hero.slide3.title',
    subtitleKey: 'hero.slide3.subtitle',
    shortKey: 'homeHero.slides.training',
    image: '/hero/hero-gepkezeloi-kepzes-foto',
    mobile: '/hero/hero-gepkezeloi-kepzes-mobile',
  },
];

const trustBadges = [
  { icon: 'shield-check', titleKey: 'trust.warranty', descKey: 'trust.warrantyDesc' },
  { icon: 'truck', titleKey: 'trust.shipping', descKey: 'trust.shippingDesc' },
  { icon: 'graduation-cap', titleKey: 'trust.training', descKey: 'trust.trainingDesc' },
  { icon: 'wrench', titleKey: 'trust.service', descKey: 'trust.serviceDesc' },
];

const icons: Record<string, string> = {
  'shield-check': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  'truck': `<path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />`,
  'graduation-cap': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />`,
  'wrench': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
};

const slideNames = slides.map((s) => t(locale, s.shortKey));
---

<section class="relative overflow-hidden">
  {/* ── MOBIL: a négyzetes kép, alatta a szöveg (csak az első dia) ── */}
  <div class="md:hidden" style="background-color: #fbf8f8;">
    <picture>
      <source type="image/avif" srcset={`${slides[0].mobile}.avif`} />
      <source type="image/webp" srcset={`${slides[0].mobile}.webp`} />
      <img
        src={`${slides[0].mobile}.jpg`}
        alt={t(locale, slides[0].titleKey)}
        class="w-full h-auto"
        width="1080"
        height="1080"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>
    <div class="px-4 pb-6 text-center" style="margin-top: 20px;">
      <h1 class="text-2xl font-normal text-[#ce2252] mb-2 leading-snug font-heading" style="white-space: pre-line;">
        {t(locale, slides[0].titleKey)}
      </h1>
      <p class="text-sm text-[#645a59] mb-4 leading-relaxed">
        {t(locale, slides[0].subtitleKey)}
      </p>
      <a
        href={contactLink}
        data-event="hero_consult_click"
        class="inline-flex items-center justify-center px-6 py-3 bg-primary-700 text-white font-semibold rounded-xl text-sm hover:bg-primary-800 active:scale-[0.98] transition-all shadow-lg"
      >
        {t(locale, 'hero.cta')}
      </a>
    </div>
  </div>

  {/* ── ASZTALI: két oszlop, átfedés nélkül; csak kattintásra lapoz ── */}
  <div
    class="hidden md:block bg-primary-50"
    data-hero-carousel
    role="region"
    aria-roledescription="carousel"
    aria-label={t(locale, 'hero.cta')}
    data-names={JSON.stringify(slideNames)}
  >
    <div class="grid">
      {slides.map((slide, index) => (
        <div
          class:list={[
            'hero-slide [grid-area:1/1] grid md:grid-cols-2 lg:grid-cols-[5fr_7fr] transition-opacity duration-500',
            index === 0 ? 'opacity-100' : 'opacity-0 invisible',
          ]}
          data-slide={index}
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} / ${slides.length}`}
          inert={index === 0 ? undefined : true}
        >
          <div class="hero-text flex flex-col justify-center py-10 pr-8 lg:pr-12 pl-6 lg:pl-8">
            <span class="hero-accent-line" aria-hidden="true"></span>
            {index === 0 ? (
              <p role="heading" aria-level="1" class="text-3xl lg:text-[2.75rem] font-normal text-[#ce2252] mb-4 leading-tight font-heading" style="white-space: pre-line;">
                {t(locale, slide.titleKey)}
              </p>
            ) : (
              <h2 class="text-3xl lg:text-[2.75rem] font-normal text-[#ce2252] mb-4 leading-tight font-heading" style="white-space: pre-line;">
                {t(locale, slide.titleKey)}
              </h2>
            )}
            <p class="text-base lg:text-lg text-[#645a59] mb-7 max-w-[34rem] leading-relaxed">
              {t(locale, slide.subtitleKey)}
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href={contactLink}
                data-event="hero_consult_click"
                class="inline-flex items-center justify-center px-6 py-3 bg-primary-700 text-white font-semibold rounded-xl hover:bg-primary-800 active:scale-[0.98] transition-all shadow-lg hover:shadow-xl text-sm"
              >
                {t(locale, 'hero.cta')}
              </a>
              <a
                href={CONTACT.phoneTel}
                data-event="hero_phone_click"
                class="inline-flex items-center justify-center px-6 py-3 bg-white text-primary-700 font-semibold rounded-xl border-2 border-primary-700/30 hover:bg-primary-50 hover:border-primary-700/60 active:scale-[0.98] transition-all text-sm"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                {CONTACT.phoneDisplay}
              </a>
            </div>
            {/* Hely a lapozónak: a vezérlő a diák fölött abszolút pozícióban ül */}
            <div class="h-[4.5rem]" aria-hidden="true"></div>
          </div>
          <div class="hero-photo relative overflow-hidden">
            <picture>
              <source type="image/avif" srcset={`${slide.image}.avif`} />
              <source type="image/webp" srcset={`${slide.image}.webp`} />
              <img
                src={`${slide.image}.jpg`}
                alt={t(locale, slide.titleKey)}
                class="absolute inset-0 w-full h-full object-cover"
                width="1000"
                height="667"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'low'}
                decoding={index === 0 ? 'sync' : 'async'}
              />
            </picture>
          </div>
        </div>
      ))}
    </div>

    {/* Lapozó: a szövegoszlop alján, a diák fölött */}
    <div class="hero-controls absolute bottom-8 z-20 flex items-center gap-3">
      <button
        type="button"
        data-hero-prev
        aria-label={t(locale, 'homeHero.prev')}
        class="w-11 h-11 rounded-xl border border-primary-700/30 bg-white text-primary-700 flex items-center justify-center hover:bg-primary-700 hover:text-white active:scale-95 transition-all cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <div class="flex items-center gap-2">
        {slides.map((_, i) => (
          <button
            type="button"
            data-hero-dot={i}
            aria-label={t(locale, 'homeHero.goTo', { n: i + 1 })}
            aria-current={i === 0 ? 'true' : undefined}
            class:list={[
              'hero-dot h-2.5 rounded-full transition-all duration-300 cursor-pointer',
              i === 0 ? 'w-8 bg-primary-700' : 'w-2.5 bg-primary-700/25 hover:bg-primary-700/50',
            ]}
          />
        ))}
      </div>
      <button
        type="button"
        data-hero-next
        aria-label={t(locale, 'homeHero.next')}
        class="w-11 h-11 rounded-xl border border-primary-700/30 bg-white text-primary-700 flex items-center justify-center hover:bg-primary-700 hover:text-white active:scale-95 transition-all cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
      </button>
      <span class="hidden lg:inline text-sm text-[#645a59] ml-1" aria-live="polite">
        {t(locale, 'homeHero.upNext')} <span data-hero-upnext>{slideNames[1]}</span>
      </span>
    </div>
  </div>

  {/* USP-sáv a hero alatt */}
  <div class="bg-white border-t border-gray-100 py-2 sm:py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-4 lg:gap-6">
        {trustBadges.map((badge) => (
          <div class="flex items-center gap-2 sm:gap-3">
            <div class="w-7 h-7 sm:w-10 sm:h-10 bg-primary-50 rounded-lg sm:rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[badge.icon]} />
            </div>
            <div>
              <div class="font-semibold text-gray-900 text-[11px] sm:text-sm leading-tight">{t(locale, badge.titleKey)}</div>
              <div class="text-[10px] sm:text-xs text-gray-500 hidden sm:block line-clamp-1">{t(locale, badge.descKey)}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  [data-hero-carousel] {
    position: relative;
  }
  /* A fotó-oszlop magassága: 1440 px-en ~560 px (3:2), nagy kijelzőn 640 px a plafon. */
  .hero-photo {
    min-height: clamp(420px, 39vw, 640px);
  }
  /* A szövegoszlop bal széle a 7xl konténerhez igazodik, a fotó a jobb szélig fut. */
  @media (min-width: 1280px) {
    .hero-text {
      padding-left: max(2rem, calc((100vw - 80rem) / 2 + 2rem));
    }
  }
  .hero-controls {
    left: 1.5rem;
  }
  @media (min-width: 1024px) {
    .hero-controls {
      left: 2rem;
    }
  }
  @media (min-width: 1280px) {
    .hero-controls {
      left: max(2rem, calc((100vw - 80rem) / 2 + 2rem));
    }
  }
  /* Ferde rózsaszín dizájn-vonal a cím fölött. */
  .hero-accent-line {
    display: block;
    width: 3.25rem;
    height: 5px;
    margin-bottom: 1.1rem;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--color-primary-500), var(--color-primary-700));
    transform: skewX(-24deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-hero-carousel]');
    if (!root || root.dataset.init) return;
    root.dataset.init = 'true';

    var slides = root.querySelectorAll('[data-slide]');
    var dots = root.querySelectorAll('[data-hero-dot]');
    var upNext = root.querySelector('[data-hero-upnext]');
    var names = JSON.parse(root.dataset.names || '[]');
    var current = 0;

    // Nincs automatikus váltás: minden diának saját címe és CTA-ja van, és
    // 5 mp alatt senki nem olvassa végig. Csak kattintásra / billentyűre lapoz.
    function goTo(index) {
      var n = slides.length;
      index = (index + n) % n;
      for (var i = 0; i < n; i++) {
        var on = i === index;
        slides[i].classList.toggle('opacity-100', on);
        slides[i].classList.toggle('opacity-0', !on);
        slides[i].classList.toggle('invisible', !on);
        if (on) slides[i].removeAttribute('inert'); else slides[i].setAttribute('inert', '');
      }
      for (var j = 0; j < dots.length; j++) {
        var active = j === index;
        dots[j].classList.toggle('w-8', active);
        dots[j].classList.toggle('bg-primary-700', active);
        dots[j].classList.toggle('w-2.5', !active);
        dots[j].classList.toggle('bg-primary-700/25', !active);
        if (active) dots[j].setAttribute('aria-current', 'true'); else dots[j].removeAttribute('aria-current');
      }
      if (upNext && names.length) upNext.textContent = names[(index + 1) % n];
      current = index;
    }

    root.querySelector('[data-hero-prev]').addEventListener('click', function () { goTo(current - 1); });
    root.querySelector('[data-hero-next]').addEventListener('click', function () { goTo(current + 1); });
    for (var k = 0; k < dots.length; k++) {
      (function (idx) { dots[idx].addEventListener('click', function () { goTo(idx); }); })(k);
    }
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { goTo(current + 1); }
      else if (e.key === 'ArrowLeft') { goTo(current - 1); }
    });

    var startX = 0, startY = 0;
    root.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX; startY = e.touches[0].clientY;
    }, { passive: true });
    root.addEventListener('touchend', function (e) {
      var dx = e.changedTouches[0].clientX - startX;
      var dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1));
    }, { passive: true });
  })();
</script>
