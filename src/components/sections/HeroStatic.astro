---
import { CONTACT, GOOGLE_RATING } from '../../lib/constants';
import { t, getLocaleFromUrl, getLocalizedUrl, type Locale } from '../../i18n/ui';

const locale = getLocaleFromUrl(Astro.url) as Locale;
const contactLink = getLocalizedUrl(locale, '/konzultacio');

// Lézervillanásos hero (Claude Design „Főoldal v2”). Egy kép, a három gép
// tengelyére szimmetrikusan vágva: asztalon 1434x1024 a jobb oszlopban,
// mobilon 1080x1080. A „lézervonal” betöltéskor egyszer végigsuhan a hero
// alsó szélén (~1 mp), aztán eltűnik – nem vágja ketté a tartalmat.
// Az intró (sötét → lézersugár → fehér villanás → kitisztul) csak az első
// látogatáskor fut, és csak JS-sel: a html-re tett `lz-intro` osztály kapcsolja
// be, így JS nélkül és csökkentett mozgásnál rögtön a kész oldal látszik.
// A Google-kártya csak akkor jelenik meg, ha a GOOGLE_RATING ki van töltve.
const image = '/hero/hero-skinlab-showroom-foto';
const mobile = '/hero/hero-skinlab-showroom-mobile';
const ratingText = GOOGLE_RATING ? GOOGLE_RATING.value.toFixed(1).replace('.', locale === 'en' ? '.' : ',') : '';

const trustBadges = [
  { icon: 'shield-check', titleKey: 'trust.warranty', descKey: 'trust.warrantyDesc' },
  { icon: 'truck', titleKey: 'trust.shipping', descKey: 'trust.shippingDesc' },
  { icon: 'graduation-cap', titleKey: 'trust.training', descKey: 'trust.trainingDesc' },
  { icon: 'wrench', titleKey: 'trust.service', descKey: 'trust.serviceDesc' },
];

const icons: Record<string, string> = {
  'shield-check': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  'truck': `<path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />`,
  'graduation-cap': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />`,
  'wrench': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
};

---

<script is:inline>
  (function () {
    try {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (localStorage.getItem('skl_lz_intro')) return;
      localStorage.setItem('skl_lz_intro', '1');
      var html = document.documentElement;
      html.classList.add('lz-intro');
      setTimeout(function () { html.classList.remove('lz-intro'); }, 3000);
    } catch (e) {}
  })();
</script>

<section class="relative overflow-hidden">
  <div class="lz-hero relative">
    <div class="lz-photo relative overflow-hidden">
      <picture>
        <source media="(max-width: 767px)" type="image/avif" srcset={`${mobile}.avif`} />
        <source media="(max-width: 767px)" type="image/webp" srcset={`${mobile}.webp`} />
        <source media="(max-width: 767px)" srcset={`${mobile}.jpg`} />
        <source type="image/avif" srcset={`${image}.avif`} />
        <source type="image/webp" srcset={`${image}.webp`} />
        <img
          src={`${image}.jpg`}
          alt={t(locale, 'homeHero.imageAlt')}
          class="w-full h-auto md:absolute md:inset-0 md:h-full md:object-cover"
          width="1434"
          height="1024"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </picture>

      {GOOGLE_RATING && (
        <div
          class="g-badge absolute left-3 bottom-3 md:left-6 md:bottom-6 flex items-center gap-2 md:gap-3 p-2 md:p-4 bg-white/95 backdrop-blur-sm rounded-lg md:rounded-xl shadow-lg md:shadow-xl"
          data-g-rating={ratingText}
        >
          <svg class="shrink-0 w-6 h-6 md:hidden" viewBox="0 0 48 48" role="img" aria-label="Google"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>
          <svg class="shrink-0 hidden md:block w-10 h-10" viewBox="0 0 48 48" role="img" aria-label="Google"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>
          <div>
            <div class="flex items-center gap-1">
              <span class="text-lg md:text-2xl font-bold text-gray-900 tabular-nums" data-g-rating-value>{ratingText}</span>
              <span class="flex text-orange-400" aria-hidden="true">
                <svg class="w-3 h-3 md:w-4 md:h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69z"/></svg>
                <span class="hidden md:flex"><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69z"/></svg><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69z"/></svg><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69z"/></svg><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69z"/></svg></span>
              </span>
            </div>
            <p class="text-[11px] md:text-[13px] text-gray-600">
              <span class="md:hidden">{t(locale, 'homeHero.googleRatingShort')}</span>
              <span class="hidden md:inline">{t(locale, 'homeHero.googleRating')}</span>
            </p>
          </div>
        </div>
      )}
    </div>

    <div class="lz-text">
      <p class="text-sm md:text-[15px] font-semibold text-primary-800 mb-3 md:mb-5">{t(locale, 'homeHero.kicker')}</p>
      <h1 class="font-heading font-normal text-[#2b1d22] text-[2rem] leading-[1.12] md:text-[2.75rem] lg:text-[3.4rem] lg:leading-[1.08] mb-4 md:mb-6">
        {t(locale, 'homeHero.title')}
        <em class="text-primary-700">{t(locale, 'homeHero.titleAccent')}</em>
      </h1>
      <p class="text-[17px] md:text-[19px] leading-relaxed text-[#4d3b42] max-w-[32rem] mx-auto md:mx-0">{t(locale, 'homeHero.text')}</p>

      <div class="mt-6 md:mt-9 flex flex-col items-center gap-2.5 md:flex-row md:flex-wrap md:items-stretch md:gap-3">
        <a
          href={contactLink}
          data-event="hero_consult_click"
          class="w-full max-w-[20rem] md:w-auto md:max-w-none inline-flex items-center justify-center min-h-[3.5rem] px-6 bg-primary-700 text-white font-semibold text-base xl:text-[17px] hover:bg-primary-800 active:scale-[0.98] transition-all"
        >
          {t(locale, 'homeHero.cta')}
        </a>
        <a
          href={CONTACT.phoneTel}
          data-event="hero_phone_click"
          class="w-full max-w-[20rem] md:w-auto md:max-w-none inline-flex items-center justify-center gap-2 min-h-[3.5rem] px-5 bg-white text-primary-800 font-semibold text-base xl:text-[17px] border border-primary-700 hover:bg-primary-50 active:scale-[0.98] transition-all"
        >
          <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          {t(locale, 'homeHero.phoneCta')}
        </a>
      </div>
      <p class="mt-4 flex items-center justify-center md:justify-start gap-2 text-sm md:text-[15px] text-[#4d3b42]">
        <svg class="w-[18px] h-[18px] shrink-0 text-emerald-700" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7" /></svg>
        {t(locale, 'homeHero.reassurance')}
      </p>
    </div>

    {/* Lézer: egyszer végigsuhan a hero alsó szélén, aztán eltűnik */}
    <div class="lz-line" aria-hidden="true"></div>
  </div>

  {/* Intró-rétegek: csak a html.lz-intro alatt látszanak, kattintást nem fognak meg */}
  <div class="lz-fx lz-dark" aria-hidden="true"></div>
  <div class="lz-fx lz-beam" aria-hidden="true"></div>
  <div class="lz-fx lz-flash" aria-hidden="true"></div>

  {/* USP-sáv a hero alatt */}
  <div class="bg-white border-t border-gray-100 py-2 sm:py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-4 lg:gap-6">
        {trustBadges.map((badge) => (
          <div class="flex items-center gap-2 sm:gap-3">
            <div class="w-7 h-7 sm:w-10 sm:h-10 bg-primary-50 rounded-lg sm:rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[badge.icon]} />
            </div>
            <div>
              <div class="font-semibold text-gray-900 text-[11px] sm:text-sm leading-tight">{t(locale, badge.titleKey)}</div>
              <div class="text-[10px] sm:text-xs text-gray-500 hidden sm:block line-clamp-1">{t(locale, badge.descKey)}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

{GOOGLE_RATING && (
  <script>
    // A pontszám 1,0-ról felpörög a valódi értékig (~1,5 mp), ha a kártya látszik.
    document.querySelectorAll<HTMLElement>('.g-badge[data-g-rating]').forEach((badge) => {
      const out = badge.querySelector<HTMLElement>('[data-g-rating-value]');
      const text = badge.dataset.gRating ?? '';
      const target = parseFloat(text.replace(',', '.'));
      if (!out || !target || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const sep = text.includes(',') ? ',' : '.';
      const start = performance.now() + 500;
      const tick = (now: number) => {
        const p = Math.min(1, Math.max(0, (now - start) / 1500));
        const v = 1 + (target - 1) * (1 - Math.pow(1 - p, 3));
        out.textContent = v.toFixed(1).replace('.', sep);
        if (p < 1) requestAnimationFrame(tick);
      };
      out.textContent = `1${sep}0`;
      requestAnimationFrame(tick);
    });
  </script>
)}

<style>
  .lz-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: #fbf3f2;
  }
  .lz-text {
    padding: 1.5rem 1rem 2rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .lz-hero {
      grid-template-columns: 5fr 6fr;
      min-height: clamp(520px, 46vw, 720px);
    }
    .lz-photo { grid-column: 2; grid-row: 1; }
    .lz-text {
      grid-column: 1; grid-row: 1;
      align-self: center;
      text-align: left;
      padding: 3rem 2rem 3rem 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .lz-text { padding-left: 2rem; }
  }
  /* A szövegoszlop bal széle a 7xl konténerhez igazodik. */
  @media (min-width: 1280px) {
    .lz-text { padding-left: max(2rem, calc((100vw - 80rem) / 2 + 2rem)); }
  }

  /* Google-kártya: finoman beúszik. */
  .g-badge { animation: gBadgeIn 0.8s ease-out 0.5s both; }
  @keyframes gBadgeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  :global(html.lz-intro) .g-badge { animation-delay: 2s; }

  /* A lézer a hero alsó szélén egyszer végigsuhan (~1 mp), aztán eltűnik.
     Mobilon a kép és a szöveg határán fut. */
  .lz-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: #ff4d86;
    box-shadow: 0 0 8px 2px rgba(255, 77, 134, 0.9), 0 0 26px 4px rgba(206, 34, 82, 0.5);
    z-index: 2;
    opacity: 0;
    transform-origin: 0 50%;
    pointer-events: none;
    animation: lzSweep 1.3s cubic-bezier(0.6, 0, 0.3, 1) 0.4s both;
  }
  @media (max-width: 767px) {
    .lz-line { top: 100vw; bottom: auto; }
  }
  @keyframes lzSweep {
    0% { transform: scaleX(0); opacity: 1; }
    72% { transform: scaleX(1); opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
  }

  /* ── Intró ── */
  .lz-fx {
    display: none;
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 10000; /* a sütibanner (9998–9999) fölött, hogy az is a villanás alatt legyen */
  }
  :global(html.lz-intro) .lz-fx { display: block; }
  .lz-dark { background: #0b0508; animation: lzDark 1.05s linear both; }
  .lz-beam {
    top: 50%;
    bottom: auto;
    height: 2px;
    background: #fff;
    box-shadow: 0 0 10px 2px #ff4d86, 0 0 40px 8px rgba(206, 34, 82, 0.8);
    animation: lzBeam 1s cubic-bezier(0.6, 0, 0.3, 1) both;
  }
  .lz-flash { background: #fff7fa; animation: lzFlash 2s ease-out both; }
  :global(html.lz-intro) .lz-hero { animation: lzWake 1.5s cubic-bezier(0.2, 0.7, 0.2, 1) 0.85s both; }
  :global(html.lz-intro) .lz-line { animation-delay: 1.9s; }

  @keyframes lzDark { 0%, 85% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes lzBeam {
    0% { transform: scale(0, 1); opacity: 1; }
    40% { transform: scale(1, 1); opacity: 1; }
    70% { transform: scale(1, 60); opacity: 1; }
    100% { transform: scale(1, 520); opacity: 0; }
  }
  @keyframes lzFlash { 0%, 32% { opacity: 0; } 42%, 50% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes lzWake {
    from { filter: blur(12px) brightness(1.7); transform: scale(1.035); }
    to { filter: none; transform: none; }
  }

