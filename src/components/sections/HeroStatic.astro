---
import { CONTACT } from '../../lib/constants';
import { t, getLocaleFromUrl, getLocalizedUrl, type Locale } from '../../i18n/ui';

const locale = getLocaleFromUrl(Astro.url) as Locale;
const contactLink = getLocalizedUrl(locale, '/konzultacio');

// Állandó fejléckép (2026-10-19): a forgató helyett egyetlen showroom-fotó
// (1434x1024, a három gép tengelyére szimmetrikusan vágva). Asztalon a jobb oszlopban, mobilon a külön 1080x1080-as vágás.
const hero = {
  titleKey: 'hero.title',
  subtitleKey: 'hero.subtitle',
  image: '/hero/hero-skinlab-showroom-foto',
  mobile: '/hero/hero-skinlab-showroom-mobile',
};

const trustBadges = [
  { icon: 'shield-check', titleKey: 'trust.warranty', descKey: 'trust.warrantyDesc' },
  { icon: 'truck', titleKey: 'trust.shipping', descKey: 'trust.shippingDesc' },
  { icon: 'graduation-cap', titleKey: 'trust.training', descKey: 'trust.trainingDesc' },
  { icon: 'wrench', titleKey: 'trust.service', descKey: 'trust.serviceDesc' },
];

const icons: Record<string, string> = {
  'shield-check': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  'truck': `<path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />`,
  'graduation-cap': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />`,
  'wrench': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
};

---

<section class="relative overflow-hidden">
  {/* ── MOBIL: a négyzetes kép, alatta a szöveg ── */}
  <div class="md:hidden" style="background-color: #fbf8f8;">
    <picture>
      <source type="image/avif" srcset={`${hero.mobile}.avif`} />
      <source type="image/webp" srcset={`${hero.mobile}.webp`} />
      <img
        src={`${hero.mobile}.jpg`}
        alt={t(locale, hero.titleKey)}
        class="w-full h-auto"
        width="1080"
        height="1080"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>
    <div class="px-4 pb-6 text-center" style="margin-top: 20px;">
      <h1 class="text-2xl font-normal text-[#ce2252] mb-2 leading-snug font-heading" style="white-space: pre-line;">
        {t(locale, hero.titleKey)}
      </h1>
      <p class="text-sm text-[#645a59] mb-4 leading-relaxed">
        {t(locale, hero.subtitleKey)}
      </p>
      <a
        href={contactLink}
        data-event="hero_consult_click"
        class="inline-flex items-center justify-center px-6 py-3 bg-primary-700 text-white font-semibold rounded-xl text-sm hover:bg-primary-800 active:scale-[0.98] transition-all shadow-lg"
      >
        {t(locale, 'hero.cta')}
      </a>
    </div>
  </div>

  {/* ── ASZTALI: két oszlop, átfedés nélkül ── */}
  <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-[5fr_7fr] bg-primary-50">
    <div class="hero-text flex flex-col justify-center py-10 pr-8 lg:pr-12 pl-6 lg:pl-8">
      <span class="hero-accent-line" aria-hidden="true"></span>
      <p role="heading" aria-level="1" class="text-3xl lg:text-[2.75rem] font-normal text-[#ce2252] mb-4 leading-tight font-heading" style="white-space: pre-line;">
        {t(locale, hero.titleKey)}
      </p>
      <p class="text-base lg:text-lg text-[#645a59] mb-7 max-w-[34rem] leading-relaxed">
        {t(locale, hero.subtitleKey)}
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={contactLink}
          data-event="hero_consult_click"
          class="inline-flex items-center justify-center px-6 py-3 bg-primary-700 text-white font-semibold rounded-xl hover:bg-primary-800 active:scale-[0.98] transition-all shadow-lg hover:shadow-xl text-sm"
        >
          {t(locale, 'hero.cta')}
        </a>
        <a
          href={CONTACT.phoneTel}
          data-event="hero_phone_click"
          class="inline-flex items-center justify-center px-6 py-3 bg-white text-primary-700 font-semibold rounded-xl border-2 border-primary-700/30 hover:bg-primary-50 hover:border-primary-700/60 active:scale-[0.98] transition-all text-sm"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {CONTACT.phoneDisplay}
        </a>
      </div>
    </div>
    <div class="hero-photo relative overflow-hidden">
      <picture>
        <source type="image/avif" srcset={`${hero.image}.avif`} />
        <source type="image/webp" srcset={`${hero.image}.webp`} />
        <img
          src={`${hero.image}.jpg`}
          alt={t(locale, hero.titleKey)}
          class="absolute inset-0 w-full h-full object-cover"
          width="1434"
          height="1024"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </picture>
    </div>
  </div>

  {/* USP-sáv a hero alatt */}
  <div class="bg-white border-t border-gray-100 py-2 sm:py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-4 lg:gap-6">
        {trustBadges.map((badge) => (
          <div class="flex items-center gap-2 sm:gap-3">
            <div class="w-7 h-7 sm:w-10 sm:h-10 bg-primary-50 rounded-lg sm:rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[badge.icon]} />
            </div>
            <div>
              <div class="font-semibold text-gray-900 text-[11px] sm:text-sm leading-tight">{t(locale, badge.titleKey)}</div>
              <div class="text-[10px] sm:text-xs text-gray-500 hidden sm:block line-clamp-1">{t(locale, badge.descKey)}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* A fotó-oszlop magassága: 1440 px-en ~560 px (3:2), nagy kijelzőn 640 px a plafon. */
  .hero-photo {
    min-height: clamp(420px, 39vw, 640px);
  }
  /* A szövegoszlop bal széle a 7xl konténerhez igazodik, a fotó a jobb szélig fut. */
  @media (min-width: 1280px) {
    .hero-text {
      padding-left: max(2rem, calc((100vw - 80rem) / 2 + 2rem));
    }
  }
  /* Ferde rózsaszín dizájn-vonal a cím fölött. */
  .hero-accent-line {
    display: block;
    width: 3.25rem;
    height: 5px;
    margin-bottom: 1.1rem;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--color-primary-500), var(--color-primary-700));
    transform: skewX(-24deg);
  }
</style>
