---
/**
 * FeaturedProduct - a főoldal kiemelt gépe (jelenleg az új EMPIRE 4WAVE).
 *
 * A havi részlet a webshop valós részletfizetési szabályából jön
 * (`lib/installment.ts`: 50% előleg, a leghosszabb elérhető futamidő), és
 * csak magyarul jelenik meg, mint a termékoldali kalkulátor.
 * Promóciós "bestseller" címke tilos; a "Most érkezett" tényállítás.
 */
import { getCollection } from 'astro:content';
import { ContentImage } from '../images';
import { hasImage, getImageAlt } from '@/lib/resolve-image';
import { getInstallmentInfo } from '@/lib/installment';
import { loadProductContent } from '@/lib/load-product-content';
import { t, getLocaleFromUrl, getLocalizedUrl, formatPrice, type Locale } from '../../i18n/ui';

interface Props {
  slug?: string;
}

const { slug = 'empire' } = Astro.props;
const locale = getLocaleFromUrl(Astro.url) as Locale;
const contactLink = getLocalizedUrl(locale, '/konzultacio');

const products = await getCollection('products', ({ data }) => !data.draft && data.slug === slug);
const product = products[0];
// Ha a kiemelt gép kikerül (draft), a szekció egyszerűen nem jelenik meg.
const d = product?.data;
const name = d ? (loadProductContent(locale, d.slug, d.categorySlug).content.name || d.name) : '';
const price = d ? (d.salePrice ?? d.price) : null;
const productLink = d ? getLocalizedUrl(locale, `/${d.categorySlug}/${d.slug}`) : '';

const installment = getInstallmentInfo(price);
const longest = installment.available ? Math.max(...installment.months) as 3 | 6 | 12 : null;
const showInstallment = locale === 'hu' && longest !== null;

// Az EMPIRE ellenőrzött adatai (src/content/products/empire.json specs).
const specs = [
  { value: t(locale, 'featuredProduct.wavelengthsValue'), label: '755 / 808 / 940 / 1064 nm' },
  { value: '1200W', label: t(locale, 'featuredProduct.power') },
  { value: 'Fitzpatrick I-VI', label: t(locale, 'featuredProduct.skinTypes') },
  { value: t(locale, 'featuredProduct.warrantyValue'), label: t(locale, 'featuredProduct.warranty') },
];
---

{d && (
<section class="bg-gradient-to-br from-primary-100 via-primary-50 to-white py-14 lg:py-20 relative overflow-hidden" id="kiemelt">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid lg:grid-cols-[5fr_6fr] gap-8 lg:gap-14 items-center">
      <a
        href={productLink}
        class="group bg-white rounded-2xl aspect-[4/3] lg:aspect-square flex items-center justify-center overflow-hidden shadow-sm border border-primary-100/60"
        data-event="home_featured_image_click"
        tabindex="-1"
        aria-hidden="true"
      >
        {d.image && hasImage(d.image) && (
          <ContentImage
            src={d.image}
            alt={getImageAlt(d.image, name)}
            class="w-full h-full object-contain p-6 group-hover:scale-[1.03] transition-transform duration-500"
          />
        )}
      </a>

      <div>
        <span class="inline-flex items-center gap-2 bg-primary-100 text-primary-700 px-3 py-1 rounded-full text-sm font-semibold mb-4">
          <span class="relative flex w-2 h-2" aria-hidden="true">
            <span class="featured-ping absolute inline-flex h-full w-full rounded-full bg-primary-500 opacity-60"></span>
            <span class="relative inline-flex rounded-full w-2 h-2 bg-primary-700"></span>
          </span>
          {t(locale, 'featuredProduct.badge')}
        </span>

        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 text-gray-900">{name}</h2>
        <p class="text-lg text-primary-700 mb-6">{t(locale, 'featuredProduct.tagline')}</p>

        <dl class="grid grid-cols-2 gap-3 mb-6">
          {specs.map((spec) => (
            <div class="bg-white rounded-xl p-3 lg:p-4 border border-gray-100 shadow-sm">
              <dt class="sr-only">{spec.label}</dt>
              <dd class="text-lg lg:text-xl font-bold text-gray-900">{spec.value}</dd>
              <dd class="text-gray-500 text-sm">{spec.label}</dd>
            </div>
          ))}
        </dl>

        {price && (
          <div class="flex flex-wrap items-end gap-x-5 gap-y-1 mb-6">
            <div>
              <div class="text-gray-500 text-sm">{t(locale, 'featuredProduct.grossPrice')}</div>
              <div class="text-3xl lg:text-4xl font-bold text-gray-900">{formatPrice(price, locale)}</div>
            </div>
            {showInstallment && longest && (
              <p class="pb-1.5 text-gray-600">
                {t(locale, 'featuredProduct.installmentLine', {
                  monthly: formatPrice(installment.monthly[longest], locale),
                  months: longest,
                })}
              </p>
            )}
          </div>
        )}

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={contactLink}
            data-event="home_featured_demo_click"
            class="bg-primary-700 hover:bg-primary-800 active:scale-[0.98] text-white font-bold py-3.5 px-7 rounded-xl text-center transition-all shadow-lg"
          >
            {t(locale, 'featuredProduct.requestDemo')}
          </a>
          <a
            href={productLink}
            data-event="home_featured_details_click"
            class="bg-white text-primary-700 font-bold py-3.5 px-7 rounded-xl text-center border-2 border-primary-700/30 hover:border-primary-700/60 hover:bg-primary-50 active:scale-[0.98] transition-all"
          >
            {t(locale, 'featuredProduct.viewDetails')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
)}

<style>
  .featured-ping {
    animation: featured-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes featured-ping {
    75%, 100% { transform: scale(2.2); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .featured-ping { animation: none; }
  }
</style>
