---
/**
 * GoogleReviews - valódi Google-vélemények + a csapatfotó a főoldalon.
 *
 * Asztalon balra a csapatfotó (Milánó, teljes 4:3 kép, görgetéskor helyben
 * marad), jobbra a Google-összesítő és a vélemény-kártyák; mobilon a fotó felül. A hosszú vélemények 6 sor után
 * levágódnak, a "Tovább olvasom" gomb nyitja ki őket (JS nélkül teljes hosszon
 * látszanak). Az értékelés-link az /ertekeles/ oldalra visz.
 * Adatok: src/data/google-reviews.ts (szó szerinti szövegek).
 */
import { ContentImage } from '../images';
import { GOOGLE_RATING } from '../../lib/constants';
import { GOOGLE_REVIEWS } from '../../data/google-reviews';
import { t, getLocaleFromUrl, type Locale } from '../../i18n/ui';

const locale = getLocaleFromUrl(Astro.url) as Locale;
const rating = GOOGLE_RATING ? GOOGLE_RATING.value.toFixed(1).replace('.', locale === 'en' ? '.' : ',') : null;
const initials = (name: string) => name.split(/\s+/).map((p) => p[0]).slice(0, 2).join('').toUpperCase();
const star = 'M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69z';
---

<section class="bg-[#fbf3f2]" id="velemenyek">
  <div class="grid lg:grid-cols-[5fr_7fr]">
    <figure class="relative aspect-[4/3] overflow-hidden m-0 lg:sticky lg:top-24 lg:self-start">
      <ContentImage
        src="@assets/skinlab-csapat-milano.jpg"
        alt={t(locale, 'googleReviews.teamAlt')}
        class="absolute inset-0 w-full h-full object-cover"
      />
      <figcaption class="absolute left-3 bottom-3 lg:left-6 lg:bottom-6 bg-white/95 px-3 py-1.5 text-sm font-semibold text-gray-900">
        {t(locale, 'googleReviews.teamCaption')}
      </figcaption>
    </figure>

    <div class="px-4 sm:px-8 py-10 lg:py-16 lg:pl-16 lg:pr-[max(2rem,calc((100vw-80rem)/2+2rem))]">
      <p class="text-sm font-bold tracking-[0.12em] uppercase text-primary-700 mb-2">{t(locale, 'googleReviews.kicker')}</p>
      <h2 class="font-heading font-normal text-[1.9rem] leading-[1.15] lg:text-[2.6rem] lg:leading-[1.12] text-gray-900 mb-3">
        {t(locale, 'googleReviews.title')}
      </h2>
      <p class="text-base lg:text-lg text-gray-700 mb-6">{t(locale, 'googleReviews.text')}</p>

      {rating && (
        <div class="inline-flex items-center gap-3 bg-white px-4 py-3 shadow-sm mb-6">
          <svg class="w-9 h-9 shrink-0" viewBox="0 0 48 48" role="img" aria-label="Google"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-2xl font-bold text-gray-900">{rating}</span>
              <span class="flex text-orange-400" aria-hidden="true">
                {[0, 1, 2, 3, 4].map(() => <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d={star} /></svg>)}
              </span>
            </div>
            <p class="text-[13px] text-gray-600">{t(locale, 'homeHero.googleRating')}</p>
          </div>
        </div>
      )}

      <div class="flex flex-col gap-4">
        {GOOGLE_REVIEWS.map((review, i) => (
          <article class="gr-card bg-white p-5 lg:p-6 shadow-sm">
            <header class="flex items-center gap-3 mb-3">
              {review.avatar ? (
                <img src={review.avatar} alt="" width="44" height="44" loading="lazy" decoding="async" class="w-11 h-11 rounded-full object-cover" />
              ) : (
                <span class="w-11 h-11 rounded-full bg-primary-100 text-primary-800 font-bold flex items-center justify-center" aria-hidden="true">{initials(review.name)}</span>
              )}
              <div class="min-w-0">
                <p class="font-bold text-gray-900 leading-tight">{review.name}</p>
                <span class="flex text-orange-400 mt-0.5" role="img" aria-label="5/5">
                  {[0, 1, 2, 3, 4].map(() => <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d={star} /></svg>)}
                </span>
              </div>
              <svg class="w-5 h-5 ml-auto shrink-0" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>
            </header>
            <p class="gr-text text-[15px] lg:text-base leading-relaxed text-gray-700 whitespace-pre-line" lang="hu" id={`gr-text-${i}`}>{review.text}</p>
            <button type="button" class="gr-more hidden mt-2 min-h-11 font-semibold text-primary-700 hover:text-primary-800" aria-controls={`gr-text-${i}`} aria-expanded="false" data-more={t(locale, 'googleReviews.readMore')} data-less={t(locale, 'googleReviews.readLess')}>
              {t(locale, 'googleReviews.readMore')}
            </button>
          </article>
        ))}
      </div>

      <a href="/ertekeles/" data-event="home_review_cta_click" class="group mt-6 inline-flex items-center gap-2 min-h-11 font-semibold text-base lg:text-[17px] text-primary-700 hover:text-primary-800">
        {t(locale, 'googleReviews.cta')}
        <svg class="w-[18px] h-[18px] group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .gr-card[data-clamp] .gr-text {
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Csak a ténylegesen hosszú véleményeket vágjuk le, és csak JS-sel.
  document.querySelectorAll<HTMLElement>('.gr-card').forEach((card) => {
    const text = card.querySelector<HTMLElement>('.gr-text');
    const btn = card.querySelector<HTMLButtonElement>('.gr-more');
    if (!text || !btn) return;
    card.setAttribute('data-clamp', '');
    if (text.scrollHeight <= text.clientHeight + 2) {
      card.removeAttribute('data-clamp');
      return;
    }
    btn.classList.remove('hidden');
    btn.addEventListener('click', () => {
      const open = card.toggleAttribute('data-clamp');
      btn.setAttribute('aria-expanded', String(!open));
      btn.textContent = (open ? btn.dataset.more : btn.dataset.less) ?? '';
    });
  });
</script>
