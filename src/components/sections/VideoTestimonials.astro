---
/**
 * VideoTestimonials - Vásárlói videós vélemények (YouTube Shorts)
 * Facade pattern: poster + play button, no iframe until click (VideoFacade)
 * Álló (9:16) videók - mobilon scroll-snap sor, desktopon 4 oszlopos grid
 * Adatok: src/data/video-testimonials.ts
 */
import { t, getLocaleFromUrl, type Locale } from '../../i18n/ui';
import VideoFacade from '../video/VideoFacade.astro';
import { VIDEO_TESTIMONIALS, videoObjectSchema, type VideoTestimonial } from '../../data/video-testimonials';

interface Props {
  /**
   * Cím felülírása. Az alapértelmezett "Ők már Skinlab géppel dolgoznak"
   * gépoldalra készült; kezelőanyag-/kellékoldalon félrevezető, mert a
   * videók márkaszintű bizonyítékok, nem az adott készítményről szólnak.
   */
  title?: string;
  /** Ezek a videók kimaradnak (pl. mert fentebb már külön VideoQuote-ként szerepelnek). */
  exclude?: VideoTestimonial['id'][];
  /** A videó alá a szó szerinti idézet is kikerül. */
  quotes?: boolean;
}

const { title, exclude = [], quotes = false } = Astro.props;
const items = VIDEO_TESTIMONIALS.filter((item) => !exclude.includes(item.id));
const gridCols = items.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-4';

const locale = getLocaleFromUrl(Astro.url) as Locale;
---

<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 lg:mb-14">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-3">
        {title || t(locale, 'videoTestimonials.title')}
      </h2>
      <p class="text-gray-600">
        {t(locale, 'videoTestimonials.subtitle')}
      </p>
    </div>

    <!-- Mobilon vízszintes scroll-snap sor, md-től 4 oszlopos grid -->
    <div class:list={['flex gap-4 overflow-x-auto snap-x snap-mandatory -mx-4 px-3 scroll-px-3 pb-4 md:grid md:gap-6 md:overflow-visible md:mx-0 md:px-0 md:scroll-px-0 md:pb-0', gridCols]}>
      {items.map((item) => (
        <div class="snap-center shrink-0 w-[68%] sm:w-[45%] md:w-auto">
          <VideoFacade
            videoId={item.videoId}
            title={`${item.name} (${item.business})`}
            alt={`${item.name} – ${t(locale, item.roleKey)} (${item.business})`}
            playLabel={`${t(locale, 'videoTestimonials.playLabel')}: ${item.name} (${item.business})`}
            class="aspect-[9/16] rounded-2xl shadow-lg"
          />

          {quotes ? (
            <figure class="mt-4">
              <blockquote class="text-gray-900 leading-relaxed">
                <p>„{t(locale, item.quoteKey)}”</p>
              </blockquote>
              <figcaption class="mt-2">
                <div class="font-bold text-gray-900">{item.name}</div>
                <div class="text-sm text-gray-500">{t(locale, item.roleKey)} · {item.business}</div>
              </figcaption>
            </figure>
          ) : (
            <div class="mt-3 text-center">
              <div class="font-bold text-gray-900">{item.name}</div>
              <div class="text-sm text-gray-500">{t(locale, item.roleKey)} · {item.business}</div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- VideoObject Schema for SEO -->
  {items.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(videoObjectSchema(item, locale))} />
  ))}
</section>
