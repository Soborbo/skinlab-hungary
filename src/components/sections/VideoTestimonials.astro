---
/**
 * VideoTestimonials - Vásárlói videós vélemények (YouTube Shorts)
 * Facade pattern: poster + play button, no iframe until click
 * Privacy-enhanced: youtube-nocookie.com
 * GA4 tracking: video_play event
 * Álló (9:16) videók - mobilon scroll-snap sor, desktopon 4 oszlopos grid
 */
import { t, getLocaleFromUrl, type Locale } from '../../i18n/ui';

const locale = getLocaleFromUrl(Astro.url) as Locale;

const testimonials = [
  {
    videoId: 'YHyZ1HheFUc',
    name: 'Zsidai Adri',
    roleKey: 'videoTestimonials.role1',
    business: 'Fancy Beauty Palota',
  },
  {
    videoId: 'yD0Rhk9kXmg',
    name: 'Török Hajnalka',
    roleKey: 'videoTestimonials.role2',
    business: 'Aurora Face Art Studio & PMU Academy',
  },
  {
    videoId: 'ftVAd7itY_0',
    name: 'Solti Anna',
    roleKey: 'videoTestimonials.role3',
    business: 'd’Ane Beauty Salon',
  },
  {
    videoId: 'VxAFGEOMq1w',
    name: 'Rácz Dóri',
    roleKey: 'videoTestimonials.role4',
    business: 'RD Beauty',
  },
];

// VideoObject schema for SEO
const videoSchemas = testimonials.map((item) => ({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": `${item.name} (${item.business})`,
  "description": `${item.name} – ${t(locale, item.roleKey)} (${item.business}) – ${t(locale, 'videoTestimonials.subtitle')}`,
  // oar2.jpg = a Shorts álló (9:16) posztere; maxresdefault itt letterboxolt lenne
  "thumbnailUrl": `https://i.ytimg.com/vi/${item.videoId}/oar2.jpg`,
  "contentUrl": `https://www.youtube.com/watch?v=${item.videoId}`,
  "embedUrl": `https://www.youtube-nocookie.com/embed/${item.videoId}`
}));
---

<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 lg:mb-14">
      <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-3">
        {t(locale, 'videoTestimonials.title')}
      </h2>
      <p class="text-gray-600">
        {t(locale, 'videoTestimonials.subtitle')}
      </p>
    </div>

    <!-- Mobilon vízszintes scroll-snap sor, md-től 4 oszlopos grid -->
    <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory -mx-4 px-4 pb-4 md:grid md:grid-cols-4 md:gap-6 md:overflow-visible md:mx-0 md:px-0 md:pb-0">
      {testimonials.map((item) => (
        <div class="snap-center shrink-0 w-[68%] sm:w-[45%] md:w-auto">
          <div
            class="video-facade relative aspect-[9/16] rounded-2xl overflow-hidden shadow-lg bg-gray-900 group"
            data-video-id={item.videoId}
            data-video-title={`${item.name} (${item.business})`}
          >
            <img
              src={`https://i.ytimg.com/vi/${item.videoId}/oar2.jpg`}
              alt={`${item.name} – ${t(locale, item.roleKey)} (${item.business})`}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />

            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/30 transition-colors" />

            <button
              type="button"
              class="video-facade-play absolute inset-0 flex w-full items-center justify-center cursor-pointer"
              aria-label={`${t(locale, 'videoTestimonials.playLabel')}: ${item.name} (${item.business})`}
            >
              <span class="w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-red-600 flex items-center justify-center shadow-xl transform transition-all duration-300 group-hover:scale-110 group-hover:bg-red-700">
                <svg class="w-7 h-7 lg:w-8 lg:h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
            </button>
          </div>

          <div class="mt-3 text-center">
            <div class="font-bold text-gray-900">{item.name}</div>
            <div class="text-sm text-gray-500">{t(locale, item.roleKey)} · {item.business}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- VideoObject Schema for SEO -->
  {videoSchemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</section>

<script is:inline>
  (function() {
    function initVideoFacades() {
      document.querySelectorAll('.video-facade[data-video-id]').forEach(function(facade) {
        if (facade.dataset.initialized) return;
        facade.dataset.initialized = 'true';

        var played = false;

        var handler = function() {
          if (played) return;
          played = true;

          var videoId = facade.dataset.videoId;
          var title = facade.dataset.videoTitle || 'Video';

          // GA4 Event tracking
          if (window.dataLayer) {
            window.dataLayer.push({
              event: 'video_play',
              video_id: videoId,
              video_title: title
            });
          }

          // Create iframe with privacy-enhanced embed
          var iframe = document.createElement('iframe');
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
          iframe.title = title;
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          iframe.className = 'absolute inset-0 w-full h-full';

          // Replace content with iframe (removes the play button too)
          facade.replaceChildren(iframe);
        };

        // Native <button> handles keyboard activation (Enter/Space) itself;
        // a thumbnail click outside the button still plays via the facade.
        var playButton = facade.querySelector('.video-facade-play');
        (playButton || facade).addEventListener('click', handler);
      });
    }

    // Init immediately and on navigation
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoFacades);
    } else {
      initVideoFacades();
    }
    document.addEventListener('astro:page-load', initVideoFacades);
  })();
</script>
