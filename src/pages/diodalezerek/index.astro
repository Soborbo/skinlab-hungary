---
/**
 * Diódalézerek kategóriaoldal (HU) - új showcase-elrendezés.
 * Szöveg: src/data/categories/diodalezerek.ts; ár, specifikáció, kép: termék-JSON.
 * A [locale] változatok egyelőre a régi CategoryLayouton maradnak.
 */
import CategoryShowcaseLayout from '../../layouts/CategoryShowcaseLayout.astro';
import { getCollection } from 'astro:content';
import { diodalezerekShowcase } from '../../data/categories/diodalezerek';

const products = await getCollection('products', ({ data }) => {
  return data.categorySlug === 'diodalezerek' && !data.draft;
});
---

<CategoryShowcaseLayout page={diodalezerekShowcase} products={products} />
