---
import CategoryLayout from '../../layouts/CategoryLayout.astro';
import { getCollection } from 'astro:content';
import antiAgingKezeles from '../../assets/products/biopen3.png';

const category = {
  name: 'Anti-aging készülékek',
  nameShort: 'Anti-aging',
  slug: 'anti-aging',
  description: 'Vákuumos mikrotűs RF és EMS mikrotűs bőrfiatalító készülékek.',
  heroDescription: 'Bőrfeszesítés, ránckezelés, hegkezelés műtét nélkül. Vákuumos mikrotűs RF és EMS mikrotűs technológia egy helyen.',
  badge: 'Fiatalosabb bőr',
  color: 'rose',
};

const products = await getCollection('products', ({ data }) => {
  return data.categorySlug === 'anti-aging' && !data.draft;
});

const benefits = [
  {
    icon: 'target',
    title: 'Célzott feszesítés',
    description: 'A mikrotűs RF a hőt közvetlenül a mélyebb bőrrétegekbe juttatja. Feszesítés műtét nélkül.',
  },
  {
    icon: 'clock',
    title: 'Nincs leállás',
    description: 'A legtöbb kezelés után azonnal visszatérhet a vendég a mindennapokhoz. Nincs regenerációs idő.',
  },
  {
    icon: 'trend-up',
    title: 'Fokozatos javulás',
    description: 'A kollagén termelődés hetek alatt fokozódik. Az eredmény akár 6-12 hónapig is tarthat.',
  },
  {
    icon: 'coins',
    title: 'Prémium kezelési árak',
    description: 'A mikrotűs RF és a mikrotűs bőrmegújító kezelések a szalonok magas árrésű, prémium szolgáltatásai közé tartoznak.',
  },
];

// GYIK: "AESTIQ AI vagy Bio Pen Q2?" - a designer (Rebeka) szövege 2026-10-06,
// magázásra igazítva. Utána a két általános kérdés marad.
const faq = [
  {
    question: 'Mi a legfontosabb különbség az AESTIQ AI és a Bio Pen Q2 között?',
    answer: 'A <strong>Bio Pen Q2</strong> egy kompakt, vezeték nélküli professzionális microneedling készülék, amely a mikrotűs kezelést EMS elektroporációval és LED fényterápiával kombinálja. Az <strong>AESTIQ AI</strong> ezzel szemben egy magasabb kategóriájú, professzionális vákuumos mikrotűs RF rendszer, amely rádiófrekvenciás energiát, vákuumos bőrstabilizálást, AI Educator rendszert és ANG™ kezelési támogatást egyesít. A két készülék tehát technológiailag és felhasználási célját tekintve is más kategóriát képvisel.',
  },
  {
    question: 'Melyiket válasszam, ha most szeretném bevezetni a mikrotűs kezeléseket a szalonomba?',
    answer: 'A Bio Pen Q2 ideális belépési pont lehet. Kis beruházással, egyszerűen beilleszthető a meglévő kezelési kínálatba, vezeték nélküli és könnyen hordozható. Microneedling, EMS elektroporáció és 470/630 nm-es LED fényterápia áll rendelkezésre egyetlen kézi készülékben.',
  },
  {
    question: 'Mikor érdemes inkább az AESTIQ AI-t választanom?',
    answer: 'Ha kifejezetten magasabb kategóriájú anti-aging, bőrfeszesítő, heges vagy textúrajavító kezeléseket szeretne kínálni, és egy komolyabb mikrotűs RF szolgáltatást építene fel. Az AESTIQ AI nem egyszerű dermapen: a mikrotűk mellett RF energiával dolgozik, vákuummal stabilizálja a kezelendő bőrfelületet, az AI Educator és ANG™ rendszer pedig a kezelő munkáját is támogatja.',
  },
  {
    question: 'A Bio Pen Q2 is rádiófrekvenciás készülék?',
    answer: 'Nem, és ez fontos különbség. A Bio Pen Q2 EMS mikroáramot (elektroporációt) használ, nem mikrotűs rádiófrekvenciát. Az AESTIQ AI valódi mikrotűs RF rendszer, amelynél az RF energia a tűs technológiával kombinálva fejti ki hatását.',
  },
  {
    question: 'Van HIFU funkció az AESTIQ AI-ban?',
    answer: 'Nincs. Az AESTIQ AI vákuumos mikrotűs RF készülék, nem HIFU. A Bio Pen Q2 sem HIFU készülék.',
  },
  {
    question: 'Melyik készülék dolgozik mélyebb, intenzívebb anti-aging technológiával?',
    answer: 'Az AESTIQ AI. A mikrotűs RF célja, hogy a mechanikai mikrotűs stimuláció mellett rádiófrekvenciás energiát is alkalmazzon a bőrben. A Bio Pen Q2 elsősorban microneedlingre, EMS elektroporációra és LED-del támogatott bőrmegújító kezelésekre szolgál.',
  },
  {
    question: 'Melyik alkalmas hatóanyag-bevitelre?',
    answer: 'Erre elsősorban a Bio Pen Q2 való. Az EMS elektroporáció a microneedlinggel kombinálva kifejezetten a professzionális hatóanyag-beviteli protokollok támogatására szolgál. Emellett tűmentes nano cartridge is rendelkezésre áll.',
  },
  {
    question: 'Melyiket válasszam aknés hegek és egyenetlen bőrtextúra kezelésére?',
    answer: 'Mindkét készülék beilleszthető bőrmegújító protokollokba, de eltérő szinten. A Bio Pen Q2 klasszikus microneedling-alapú megoldást kínál, míg az AESTIQ AI mikrotűs RF technológiával magasabb kategóriájú, intenzívebb kezelési szolgáltatás kialakítására alkalmas.',
  },
  {
    question: 'Miért kerül jelentősen többe az AESTIQ AI?',
    answer: 'Mert nem ugyanazt a technológiát kapja nagyobb gépházban. Az AESTIQ AI egy komplett professzionális platform: vákuumos mikrotűs RF + AI Educator + ANG™ kezelési támogatás. A Bio Pen Q2 ezzel szemben egy kompakt, vezeték nélküli microneedling + EMS + LED készülék. A választásnál ezért nem pusztán az árkülönbséget, hanem a bevezetni kívánt kezelés kategóriáját és árazhatóságát érdemes figyelembe venni.',
  },
  {
    question: 'Röviden: melyiket válasszam?',
    answer: '<strong>Bio Pen Q2</strong>, ha kedvező beruházással szeretne professzionális microneedling, EMS és LED kezeléseket bevezetni.<br><br><strong>AESTIQ AI</strong>, ha prémium, magasabb kezelési árú vákuumos mikrotűs RF anti-aging szolgáltatást szeretne kialakítani AI-alapú kezelői támogatással.',
  },
  {
    question: 'Mikor látható az eredmény?',
    answer: 'Közvetlenül a kezelés után enyhe feszesedés érezhető, a valódi eredmény a kollagén-újraképződéssel 4-6 hét alatt alakul ki. Kúraszerű kezeléssel a hatás fokozható.',
  },
  {
    question: 'Kinek ajánlott anti-aging kezelés?',
    answer: '30 év felett prevencióként, 40+ korban aktív ránckezelésre. Petyhüdt arcbőr, dupla áll, toka kezelésére is kiváló. Nem javasolt terhesség alatt, pacemakernél és bizonyos bőrbetegségeknél.',
  },
];

// Kategórián belüli modell-összehasonlítás (a tényleges, publikált gépek).
// Az alap szándékosan nem nyers spec-háború: a két gép eltérő kategória
// (asztali AI-platform vs. kézi pen), ezért ár / technológia / felhasználás /
// kinek-ajánlott a döntést segítő szempontok.
const comparison = {
  features: ['Ár', 'Technológia', 'Kialakítás', 'Extra', 'Alkalmazás', 'Ajánlott'],
  products: [
    {
      name: 'AESTIQ AI',
      tag: 'AI platform',
      tagColor: 'purple',
      highlighted: true,
      link: '/anti-aging/aestiq-ai',
      specs: {
        'Ár': '1 699 990 Ft',
        'Technológia': 'Vákuumos mikrotűs RF',
        'Kialakítás': 'Asztali platform',
        'Extra': 'AI Educator + ANG™ tűvezérlés',
        'Alkalmazás': 'Ráncok, aknés hegek, striák, textúra',
        'Ajánlott': 'Profi anti-aging fő szolgáltatásnak',
      },
    },
    {
      name: 'Bio Pen Q2',
      tag: 'Kézi, mobil',
      tagColor: 'blue',
      link: '/anti-aging/q2-biopen',
      specs: {
        'Ár': '89 990 Ft',
        'Technológia': 'EMS mikrotű + LED fényterápia',
        'Kialakítás': 'Vezeték nélküli kézi pen',
        'Extra': 'Kék 470 nm / vörös 630 nm LED',
        'Alkalmazás': 'Arc, szemkörnyék, fejbőr, test',
        'Ajánlott': 'Belépő / kiegészítő, mobil kezelések',
      },
    },
  ],
};

const choicesHeading = 'Melyik anti-aging gép való hozzád?';
const choicesSubheading = 'Egy asztali AI-platform és egy mobil kézi pen – más célra, más árszinten';
---

<CategoryLayout
  category={category}
  products={products}
  benefits={benefits}
  benefitsImage={antiAgingKezeles}
  benefitsImageAlt="Bio Pen Q2 mikrotűs arckezelés a szalonban"
  faq={faq}
  comparison={comparison}
  choicesHeading={choicesHeading}
  choicesSubheading={choicesSubheading}
/>
