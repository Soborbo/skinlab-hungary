---
import CategoryLayout from '../../layouts/CategoryLayout.astro';
import { getCollection } from 'astro:content';
import monduniqStand from '../../assets/monduniq-professzionalis-kozmetikumok.jpg';

const category = {
  name: "M'ONDUNIQ professzionális kozmetikumok",
  nameShort: "M'ONDUNIQ",
  slug: 'kezeloanyagok',
  description: "M'ONDUNIQ professzionális kezelőanyagok: hydra-liquidek, hatóanyag-koktélok és exoszómás készítmények.",
  heroDescription: "Aqua-peeling hydra-liquidek, hatóanyag-koktélok, exoszómás készítmények és a teljes LaserIQ carbon peeling protokoll. A géphez a hozzá való kezelőanyag — hivatalos forgalmazó, eredeti termékek.",
  badge: 'Kizárólagos márka',
  color: 'kezeloanyagok',
};

const products = await getCollection('products', ({ data }) => {
  return data.categorySlug === 'kezeloanyagok' && !data.draft;
});

// A rács csoportosítása termékvonal szerint. A LaserIQ blokk sorrendje szándékosan
// NEM ár szerinti, hanem a kezelési protokoll valós lépéssorrendje: bőrelőkészítés →
// kezelés → azonnali regeneráció → otthon folytatható ápolás. Így a kozmetikus a saját
// munkafolyamatában látja, mi hiányzik neki.
const productGroups = [
  {
    title: "M'ONDUNIQ LaserIQ – carbon peeling és lézeres protokoll",
    subtitle:
      'A kezelési protokoll lépéssorrendjében: bőrelőkészítés, a carbon peeling kezelés, az azonnali regeneráció, végül az otthon folytatható ápolás.',
    slugs: [
      'monduniq-laseriq-enzym-peeling',
      'monduniq-mandelic-prep-foam',
      'monduniq-carbon-gel',
      'monduniq-laseriq-calm-recovery-cocktail',
      'monduniq-laseriq-biocell-maszk',
      'monduniq-laseriq-carbon-cleanse-por',
      'monduniq-nyugtato-erfalerosito-krem',
      'monduniq-laseriq-anti-age-spf50',
    ],
  },
  {
    title: 'AquametiQ hydra-liquidek – aqua-peeling kezelőfolyadékok',
    subtitle:
      'Hidrodermabráziós és aqua-peeling gépekbe töltendő hatóanyagos kezelőfolyadékok. Négy változat: savas előkészítő, hidratáló, világosító és ozmotikus öblítővíz.',
    slugs: ['monduniq-aquametiq-hydra-prime'],
  },
  {
    title: 'Hatóanyag-koktélok, szérumok és maszkok',
    subtitle:
      'Mikrotűs mezoterápiához, nano kezelésekhez, elektroporációhoz, oxigéninfúzióhoz és hidegplazmás protokollokhoz.',
    slugs: [
      'monduniq-genexem-lsev-100-szerum',
      'monduniq-genexem-exobiocell-maszk',
      'monduniq-botopax-peptid-koktel',
      'monduniq-vitaminkoktel-kaviarral',
      'monduniq-dragon-blood-szerum',
      'monduniq-sebobalance-pro-ampulla',
      'monduniq-dermoaktiv-stabilizalo-krem',
    ],
  },
];

// A layout alapértelmezett bizalmi jelvényei gépígéretek ("2 év garancia",
// "Ingyenes betanítás", "Magyar szerviz") - egy krémre vagy ampullára egyik sem
// igaz. Csak ellenőrizhető állítás kerül ide; szállítási határidő szándékosan nem,
// arra nincs vállalásunk.
const trustBadges = [
  { title: 'Eredeti, hivatalos termékek' },
  { title: 'Foxpost vagy MPL szállítás' },
  { title: 'Személyes átvétel Érden' },
];

const benefits = [
  {
    icon: 'check-circle',
    title: 'Eredeti, hivatalos termékek',
    description: 'Közvetlen forgalmazás a gyártóktól. Garantált minőség, eredetiség igazolás minden tételhez.',
  },
  {
    icon: 'sparkles',
    title: 'Teljes protokollok, nem külön tételek',
    description: 'A bőrelőkészítéstől az otthoni fenntartásig minden lépéshez van készítmény, egymásra épülő rendszerben.',
  },
  {
    icon: 'package',
    title: 'A készülékeidhez illesztve',
    description: 'Carbon peeling, hidrodermabrázió, mikrotűs RF, hidegplazma, mezoterápia — a kezelőanyag-ellátás egy helyen.',
  },
  {
    icon: 'truck',
    title: 'Kényelmes átvétel',
    description: 'Foxpost automatába vagy MPL-lel házhoz, illetve személyes átvétel az érdi showroomban.',
  },
];
---

<CategoryLayout
  category={category}
  products={products}
  productGroups={productGroups}
  benefits={benefits}
  trustBadges={trustBadges}
  heroImage={monduniqStand}
  heroImageAlt="A Skinlab csapata a M'ONDUNIQ professzionális kozmetikumok standján"
/>
