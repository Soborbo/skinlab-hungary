---
import BlogPostLayout from '../../../components/pages/BlogPostLayout.astro';
import { getBlogPosts } from '@/lib/blog';

export async function getStaticPaths() {
  // Csak a fordítások (`{locale}/{slug}` id), vázlat nélkül.
  return (await getBlogPosts())
    .filter((post) => post.id.includes('/'))
    .map((post) => {
      const [locale, ...rest] = post.id.split('/');
      return {
        params: { locale, slug: rest.join('/') },
        props: { post },
      };
    });
}

const { post } = Astro.props;
---

<BlogPostLayout post={post} />
