---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import { getCollection } from 'astro:content';
import { locales, defaultLocale } from '../../../i18n/ui';
import { buildProductData } from '../../../lib/product-data';

export async function getStaticPaths() {
  const nonDefaultLocales = locales.filter((l) => l !== defaultLocale);
  const products = await getCollection('products', ({ data }) => {
    return data.categorySlug === 'arckezelo-rendszerek' && !data.draft;
  });
  // Egyetlen élő termék esetén a termékoldal a kategória URL-jén áll
  // (index.astro), ezért külön /arckezelo-rendszerek/<slug>/ oldal nem készül.
  if (products.length < 2) return [];

  return nonDefaultLocales.flatMap((locale) =>
    products.map((product) => ({
      params: { locale, slug: product.data.slug },
      props: { product },
    }))
  );
}

const { product } = Astro.props;
---

<ProductLayout product={buildProductData(product)} />
