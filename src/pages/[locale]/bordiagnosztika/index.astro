---
/**
 * Bőrdiagnosztika kategóriaoldal, nem magyar nyelvek. Ahol van szövegfájl
 * (src/data/categories/bordiagnosztika/<nyelv>.ts), az új elrendezés jelenik meg, máshol a régi.
 */
import CategoryPage from '../../../layouts/CategoryPage.astro';
import { locales, defaultLocale, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales
    .filter((l) => l !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<CategoryPage slug="bordiagnosztika" locale={locale} />
