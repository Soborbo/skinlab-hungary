---
/**
 * Hydrafacial kategóriaoldal (HU) - showcase-elrendezés, hero-videóval.
 * Szöveg: src/data/categories/hydrafacial.ts; ár, specifikáció, kép: termék-JSON.
 * A [locale] változatok egyelőre a régi CategoryLayouton maradnak.
 */
import CategoryShowcaseLayout from '../../layouts/CategoryShowcaseLayout.astro';
import { getCollection } from 'astro:content';
import { hydrafacialShowcase } from '../../data/categories/hydrafacial';

const products = await getCollection('products', ({ data }) => {
  return data.categorySlug === 'hydrafacial' && !data.draft;
});
---

<CategoryShowcaseLayout page={hydrafacialShowcase} products={products} />
