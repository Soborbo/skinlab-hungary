---
import BlogPage from '../../components/pages/BlogPage.astro';
import { getBlogPosts } from '@/lib/blog';

// Amíg nincs publikált magyar cikk: valódi 404 (nem üres „hamarosan” oldal), így
// az útvonal kimarad az indexből. (Sima 404 Response, mert 'server' outputban egy
// on-demand útvonal nem írhatja át az előrenderelt 404-et.) Ilyenkor semmi nem linkel ide.
export const prerender = false;
if ((await getBlogPosts('hu')).length === 0) return new Response(null, { status: 404, statusText: 'Not Found' });
---

<BlogPage />
