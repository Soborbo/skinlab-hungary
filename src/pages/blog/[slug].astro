---
import BlogPostLayout from '../../components/pages/BlogPostLayout.astro';
import { getBlogPosts } from '@/lib/blog';

export async function getStaticPaths() {
  // Csak a magyar cikkek; a fordításokat a /[locale]/blog/[slug] szolgálja ki.
  return (await getBlogPosts('hu')).map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
---

<BlogPostLayout post={post} />
