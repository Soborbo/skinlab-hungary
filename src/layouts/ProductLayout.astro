---
/**
 * ProductLayout - Unified product page layout
 *
 * Section order (előbb a gép, utána bizonyíték, pénz, támogatás, összehasonlítás):
 * Breadcrumb → Hero → USP → VariantDetails → Intro (VideoDescription) →
 * VideoQuote#1 → FeatureRows → Gallery → Science (ha van) → Finance (ROI + részlet) → VideoQuote#2 →
 * Training → VideoQuote#3 → OwnerStory → FounderConsult (+expert quote) →
 * TechSpecs → Comparison → FunctionCards → WhatsIncluded → Warranty (compact) →
 * VideoQuote#4 → Testimonials → FAQ → BuyerChecklist → CTA(primary) → Related
 *
 * Fogyóeszközök (kezelőanyag, kellék): nincs pénzügy, garancia és
 * összehasonlítás; a 4 videós véleményből csak #1 és #4.
 *
 * All sections are standalone components - zero inline HTML.
 * i18n-aware: uses loadProductContent for locale-specific content,
 * t() for UI chrome, getLocalizedUrl for links.
 */

import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/product/Breadcrumb.astro';
import ProductHero from '../components/product/ProductHero.astro';
import ProductGallerySection from '../components/product/ProductGallerySection.astro';
import FounderConsult from '../components/cta/FounderConsult.astro';
import FinanceSection from '../components/product/FinanceSection.astro';
import VideoDescription from '../components/product/VideoDescription.astro';
import ProductCTA from '../components/product/ProductCTA.astro';
import FeatureRows from '../components/product/FeatureRows.astro';
import TrainingCard from '../components/product/TrainingCard.astro';
import Testimonials from '../components/product/Testimonials.astro';
import OwnerStory from '../components/product/OwnerStory.astro';
import TechSpecs from '../components/product/TechSpecs.astro';
import FunctionCards from '../components/product/FunctionCards.astro';
import WhatsIncluded from '../components/product/WhatsIncluded.astro';
import BuyerChecklist from '../components/product/BuyerChecklist.astro';
import ProductFAQ from '../components/product/ProductFAQ.astro';
import WarrantyService from '../components/product/WarrantyService.astro';
import RelatedProducts from '../components/product/RelatedProducts.astro';
import VariantDetails from '../components/product/VariantDetails.astro';
import USPStrip from '../components/product/USPStrip.astro';
import ProductComparison from '../components/product/ProductComparison.astro';
import VideoQuote from '../components/video/VideoQuote.astro';
import { getInstallmentInfo } from '@/lib/installment';
import { getCategorySiblings, buildComparison, COMPARISON_SIBLINGS } from '@/lib/product-comparison';
import manifest from '@/lib/image-manifest.json';
// Schema components
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import FAQSchema from '../components/schema/FAQSchema.astro';
import { SITE, CATEGORIES } from '../lib/constants';
import { getLocaleFromUrl, t, getLocalizedUrl } from '@/i18n';
import { loadProductContent } from '@/lib/load-product-content';
import { getOgImagePath } from '@/lib/resolve-image';
import { courierOptionsForPrice } from '@/lib/shipping/methods';
import { resolveBrand } from '@/lib/merchant/brand';
import type { ProductContentFAQItem } from '@/lib/types/product-content';
import type { ProductData } from '@/lib/product-data';

interface Props {
  /** A route-ok `buildProductData(entry)`-vel állítják elő (lib/product-data.ts). */
  product: ProductData;
}

const { product } = Astro.props;

// Determine locale from URL
const locale = getLocaleFromUrl(Astro.url);

// Load localized product content (cascades: product JSON → category JSON → undefined)
const { content } = loadProductContent(locale, product.slug, product.categorySlug);

// Resolve content with fallbacks to collection data
const displayName = content.name || product.name;
const displayShortDesc = content.shortDescription || product.shortDescription;
const displayDesc = content.description || product.description;
const resolvedFaq = (content.faq || product.faq || []) as ProductContentFAQItem[];
const resolvedWhatsIncluded = content.whatsIncluded || product.whatsIncluded || [];
const resolvedSpecs = content.specs || product.specs || {} as Record<string, string>;
const resolvedTestimonials = content.testimonials || [];
const resolvedExpertQuote = content.expertQuote;
const resolvedFunctionCards = content.functionCards || [];

// Find category info
const category = CATEGORIES.find(c => c.slug === product.categorySlug);
const categoryName = category?.nameShort || product.categorySlug;

// Page URL (trailing slash to match the served/canonical URL).
// NB: the slash is concatenated, not placed inside the template literal — a
// getLocalizedUrl now returns the trailing-slash form, so no manual `+ '/'`.
const pageUrl = SITE.url + getLocalizedUrl(locale, `/${product.categorySlug}/${product.slug}`);

// Canonical override: spin-off/duplicate products (e.g. a limited-edition colour
// that is also a variant of the canonical product) point to the canonical slug.
const canonicalOverride = product.canonicalSlug
  ? `${SITE.url}${getLocalizedUrl(locale, `/${product.categorySlug}/${product.canonicalSlug}`)}`
  : undefined;

// Breadcrumb items for schema
const breadcrumbItems = [
  { name: t(locale, 'breadcrumb.home'), url: SITE.url + '/' },
  { name: categoryName, url: SITE.url + getLocalizedUrl(locale, `/${product.categorySlug}`) },
  { name: displayName }
];

// Extract first YouTube video URL
const firstVideoUrl = product.youtubeVideos?.[0] || '';



/**
 * Fogyóeszköz-kategóriák: kezelőanyagok és kellékek.
 *
 * A termékoldal sablonja gépekre készült, és több szekciója értelmetlen vagy
 * kifejezetten félrevezető egy 7 000 Ft-os tisztítóporon:
 *  - megtérülés-kalkulátor: a kezelőanyag nem termel kezelésenkénti bevételt,
 *    a "hány kezelés alatt térül meg" kérdés fel sem merül
 *  - garancia/szerviz: cseregép, eredeti alkatrész, sorozatszám - nincs értelmük
 *  - a gépre utaló feliratok ("…a {termék} gépről", "a többi készülékünket")
 *
 * A gépoldalak viselkedése változatlan marad.
 */
const CONSUMABLE_CATEGORIES = ['kezeloanyagok', 'kellekek'];
const isConsumable = CONSUMABLE_CATEGORIES.includes(product.categorySlug);

// Részletfizetés: csak HU, gépeknél, a minimum felett. Ugyanez a feltétel adja
// a hero részlet-sorát és a "Havi részlet" fület, így a #kalkulator anchor sosem lóg.
const offerPriceForInstallment = product.salePrice ?? product.price;
const installmentInfo = getInstallmentInfo(offerPriceForInstallment ?? 0);
const showInstallment = locale === 'hu' && !isConsumable && installmentInfo.available;
const longestTerm = installmentInfo.months[installmentInfo.months.length - 1];
const heroInstallment = showInstallment && longestTerm
  ? { downPayment: installmentInfo.downPayment, months: longestTerm, monthly: installmentInfo.monthly[longestTerm] }
  : undefined;

// Képek: a hero egyetlen nagy képet mutat (design fotó elöl, ha van); a Galéria
// szekció az összes fotót (design + termék + extra + showroom) rácsban adja.
const showroomKeys = Object.keys(manifest)
  .filter((key) => key.startsWith(`@assets/showroom/${product.slug}/`))
  .sort();
const galleryImages = [...new Set([
  ...product.designImages,
  product.image,
  ...product.gallery,
  ...product.extraImages,
  ...showroomKeys,
])].filter(Boolean);
const heroFirstImage = product.designImages[0] ?? product.image;
const introImage = product.designImages[1]
  ?? product.gallery.find((img) => img !== heroFirstImage)
  ?? product.image;

// Kategória-testvérek: összehasonlító tábla (gépek) + RelatedProducts csak ha
// maradt olyan testvér, ami nem fért a táblába.
const { current: currentEntry, siblings } = await getCategorySiblings(product.slug, product.categorySlug);
const comparison = !isConsumable && currentEntry ? buildComparison(locale, currentEntry, siblings) : null;
const showRelated = siblings.length > (comparison ? COMPARISON_SIBLINGS : 0);

// FAQ questions for schema (if available)
const faqQuestions = resolvedFaq.map(item => ({
  question: item.question,
  answer: item.answer
}));

// Build variant image sets (only if variants have per-variant images)
const variantImageSets = product.hasVariants && product.variants.some(v => v.images && v.images.length > 0)
  ? product.variants
      .filter(v => v.images && v.images.length > 0)
      .map(v => ({ value: v.value, images: v.images! }))
  : undefined;

// OG image - use the product's main image
const ogImage = getOgImagePath(product.image) || '/og-image.jpg';

// Aggregate rating + reviews from testimonials → rich snippets (schema.org)
const ratedTestimonials = (resolvedTestimonials as any[]).filter((tm) => typeof tm.rating === 'number' && tm.rating > 0);
const toIsoDate = (d?: string): string | null => {
  const m = String(d || '').match(/(\d{4})\.\s*(\d{1,2})\.\s*(\d{1,2})/);
  return m ? `${m[1]}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}` : null;
};
const stripHtml = (str?: string) => String(str || '').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const aggregateRating = ratedTestimonials.length > 0 ? {
  "@type": "AggregateRating",
  "ratingValue": (ratedTestimonials.reduce((sum, tm) => sum + tm.rating, 0) / ratedTestimonials.length).toFixed(1),
  "reviewCount": String(ratedTestimonials.length),
  "bestRating": "5",
  "worstRating": "1",
} : null;
const reviewSchema = ratedTestimonials.map((tm) => {
  const iso = toIsoDate(tm.date);
  return {
    "@type": "Review",
    "author": { "@type": "Person", "name": tm.name },
    ...(iso ? { "datePublished": iso } : {}),
    "reviewRating": { "@type": "Rating", "ratingValue": String(tm.rating), "bestRating": "5", "worstRating": "1" },
    "reviewBody": stripHtml(tm.text),
  };
});

// Offer price validity end of next year.
const priceValidUntil = `${new Date().getFullYear() + 1}-12-31`;

/**
 * Szállítási adat a strukturált ajánlathoz.
 *
 * Korábban itt fixen "0 HUF" díj és 10-20 NAPOS kézbesítés szerepelt minden
 * terméken - egyik sem igaz: a kellék-ágon 1 490 / 3 490 Ft a díj, a
 * kézbesítés pedig munkanapokban mérhető. A Merchant Center a feedet ÖSSZEVETI
 * az oldal strukturált adatával, tehát a hamis 0 Ft ott is elutasítást hozna.
 *
 * Nagy értékű gépeknél (>= SHIPPING_THRESHOLD) nincs automatizált futár - ott a
 * `shippingDetails` teljesen kimarad, mert a kiszállítás egyedi egyeztetés
 * alapján történik, díja előre nem állítható. (A Merchant Center feed ilyenkor
 * az ingyenes személyes átvételt adja meg; lásd lib/merchant/feed.ts.)
 */
const offerPrice = product.salePrice || product.price;
const shippingDetails = courierOptionsForPrice(offerPrice).map((option) => ({
  "@type": "OfferShippingDetails",
  "shippingRate": {
    "@type": "MonetaryAmount",
    "value": String(option.fee),
    "currency": "HUF"
  },
  "shippingDestination": {
    "@type": "DefinedRegion",
    "addressCountry": "HU"
  },
  "deliveryTime": {
    "@type": "ShippingDeliveryTime",
    "handlingTime": {
      "@type": "QuantitativeValue",
      "minValue": option.handling.min,
      "maxValue": option.handling.max,
      "unitCode": "DAY"
    },
    "transitTime": {
      "@type": "QuantitativeValue",
      "minValue": option.transit.min,
      "maxValue": option.transit.max,
      "unitCode": "DAY"
    }
  }
}));

// A galéria képei is bekerülnek a schema-ba (a Google több képet is felhasznál
// a rich resulthoz), abszolút URL-re oldva, duplikáció nélkül.
const schemaImages = [...new Set([ogImage, ...(product.gallery ?? []).map(getOgImagePath)])]
  .filter(Boolean)
  .slice(0, 6)
  .map((path) => new URL(path, SITE.url).href);

// Product schema
const productSchema = product.price ? {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${pageUrl}#product`,
  "name": displayName,
  "description": displayShortDesc || displayDesc?.slice(0, 200),
  "sku": product.sku,
  "brand": { "@type": "Brand", "name": resolveBrand(product.name, product.brand) },
  "image": schemaImages,
  "offers": {
    "@type": "Offer",
    "url": pageUrl,
    "priceCurrency": "HUF",
    "price": String(product.salePrice || product.price),
    "priceValidUntil": priceValidUntil,
    "availability": product.availability === 'in_stock'
      ? "https://schema.org/InStock"
      : product.availability === 'preorder'
        ? "https://schema.org/PreOrder"
        : "https://schema.org/OutOfStock",
    "seller": { "@type": "Organization", "@id": `${SITE.url}#organization`, "name": "Skinlab Hungary" },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "HU",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 14,
      "returnMethod": "https://schema.org/ReturnByMail"
    },
    ...(shippingDetails.length > 0 ? { "shippingDetails": shippingDetails } : {})
  },
  ...(aggregateRating ? { "aggregateRating": aggregateRating, "review": reviewSchema } : {})
} : null;
---

<BaseLayout
  title={content.metaTitle || product.metaTitle || displayName}
  description={content.metaDescription || product.metaDescription || displayShortDesc || displayDesc?.slice(0, 160)}
  image={ogImage}
  schema={productSchema}
  canonicalOverride={canonicalOverride}
>
  <!-- E-commerce: view_item data for tracking -->
  <div id="track-view-item"
    data-item-id={product.sku}
    data-item-name={displayName}
    data-item-category={product.categorySlug}
    data-item-price={String(product.salePrice || product.price || 0)}
    style="display:none"
  ></div>
  <!-- Schema.org Structured Data -->
  <BreadcrumbSchema items={breadcrumbItems} currentUrl={pageUrl} />
  {faqQuestions.length > 0 && <FAQSchema url={pageUrl} questions={faqQuestions} />}

  <!-- Termék-szintű akcentus-téma (global.css [data-product-theme]); nélküle márkarózsaszín. -->
  <div data-product-theme={product.theme}>

    <!-- 0. BREADCRUMB -->
    <Breadcrumb
      locale={locale}
      categorySlug={product.categorySlug}
      categoryName={categoryName}
      productName={displayName}
    />

    <!-- 1. HERO (egy nagy kép + "Mind a N fotó", ár alatt részlet-sor) -->
    <ProductHero
      locale={locale}
      slug={product.slug}
      name={displayName}
      sku={product.sku}
      shortDescription={displayShortDesc}
      description={displayDesc}
      price={product.price}
      salePrice={product.salePrice}
      image={product.image}
      gallery={product.gallery}
      designImages={product.designImages}
      availability={product.availability}
      hasVariants={product.hasVariants}
      variants={product.variants}
      featured={product.featured}
      categorySlug={product.categorySlug}
      variantImageSets={variantImageSets}
      installment={heroInstallment}
      hero={product.hero}
    />

    <!-- 2. USP STRIP -->
    <USPStrip consumable={isConsumable} />

    <!-- 3. VARIANT DETAILS -->
    {product.hasVariants && product.variants.length > 0 && (
      <VariantDetails
        locale={locale}
        variants={product.variants}
        productName={displayName}
      />
    )}

    <!-- 4. INTRO: mi ez a gép (videó, vagy nagy fotó + kulcsszámok) -->
    {content.videoDescription && (
      <VideoDescription
        locale={locale}
        videoUrl={firstVideoUrl}
        productName={displayName}
        content={content.videoDescription}
        fallbackImage={introImage}
        localVideo={product.introVideo}
        stats={content.stats}
      />
    )}

    <!-- 5. VÉLEMÉNY #1 -->
    <VideoQuote testimonial="anna" videoSide="left" />

    <!-- 6. FEATURE ROWS -->
    {content.featureRows && content.featureRows.features.length > 0 && (
      <FeatureRows
        locale={locale}
        content={content.featureRows}
      />
    )}

    <!-- 7. GALÉRIA (minden fotó; a hero csak egyet mutat) -->
    {galleryImages.length > 1 && (
      <ProductGallerySection
        images={galleryImages}
        productName={displayName}
        maxTiles={8}
      />
    )}

    <!-- 7b. HOGYAN MŰKÖDIK? (csak ha a termék tartalma megadja) -->
    {content.science && content.science.features.length > 0 && (
      <FeatureRows
        locale={locale}
        content={content.science}
        id="hogyan-mukodik"
        tone="tint"
      />
    )}

    {!isConsumable && (
      <>
        {/* 8. MEGÉRI? (megtérülés + havi részlet) */}
        <FinanceSection
          locale={locale}
          price={offerPriceForInstallment}
          defaultTreatmentPrice={content.roi?.defaultTreatmentPrice}
          showInstallment={showInstallment}
        />

        {/* 9. VÉLEMÉNY #2 */}
        <VideoQuote testimonial="adri" videoSide="right" />
      </>
    )}

    <!-- 10. TRAINING -->
    {content.training && (
      <TrainingCard
        locale={locale}
        content={content.training}
        images={product.trainingImages}
      />
    )}

    <!-- 11. VÉLEMÉNY #3 -->
    {!isConsumable && <VideoQuote testimonial="hajnalka" videoSide="left" />}

    <!-- 12. OWNER STORY (átadás + betanítás fotók egy valódi vevőnél; mappa-vezérelt) -->
    <OwnerStory
      locale={locale}
      slug={product.slug}
      productName={displayName}
      ownerName={content.ownerStory?.ownerName}
      intro={content.ownerStory?.intro}
    />

    <!-- 13. SZEMÉLYES SEGÍTSÉG (a termék szakértői idézetével) -->
    <FounderConsult
      eventPrefix="product"
      heading={isConsumable ? 'consumable' : 'machine'}
      tone="dark"
      quote={resolvedExpertQuote}
    />

    <!-- 14. TECH SPECS -->
    {Object.keys(resolvedSpecs).length > 0 && (
      <TechSpecs
        locale={locale}
        specs={resolvedSpecs}
        productName={displayName}
        datasheet={product.datasheet}
        title={isConsumable && locale === 'hu' ? 'Termékadatok' : undefined}
        subtitle={isConsumable && locale === 'hu'
          ? `A ${displayName} részletes adatai`
          : undefined}
      />
    )}

    <!-- 15. ÖSSZEHASONLÍTÁS a kategória többi gépével -->
    {comparison && <ProductComparison locale={locale} table={comparison} />}

    <!-- 16. FUNCTION CARDS -->
    {resolvedFunctionCards.length > 0 && (
      <FunctionCards
        locale={locale}
        functions={resolvedFunctionCards}
      />
    )}

    <!-- 17. WHATS INCLUDED -->
    {resolvedWhatsIncluded.length > 0 && (
      <WhatsIncluded
        locale={locale}
        items={resolvedWhatsIncluded}
        productName={displayName}
        showWarrantyBadge={!isConsumable}
        title={isConsumable && locale === 'hu' ? 'Mit tartalmaz a csomag?' : undefined}
        subtitle={isConsumable && locale === 'hu' ? 'A kiszerelés pontos tartalma' : undefined}
      />
    )}

    <!-- 18. WARRANTY (összefoglaló + link a /garancia/ oldalra) -->
    {!isConsumable && (
      <WarrantyService locale={locale} productName={displayName} compact />
    )}

    <!-- 19. VÉLEMÉNY #4 -->
    <VideoQuote testimonial="dori" videoSide="right" />

    <!-- 20. TESTIMONIALS (szöveges; a Product schema review-jai ezekből épülnek,
         ezért láthatónak kell maradniuk) -->
    {resolvedTestimonials.length > 0 && (
      <Testimonials
        locale={locale}
        testimonials={resolvedTestimonials}
        productName={displayName}
      />
    )}

    <!-- 21. FAQ -->
    {resolvedFaq.length > 0 && (
      <ProductFAQ
        locale={locale}
        faq={resolvedFaq}
        productName={displayName}
        subtitle={isConsumable && locale === 'hu'
          ? `Minden, amit a ${displayName} készítményről tudni érdemes`
          : undefined}
      />
    )}

    <!-- 22. BUYER CHECKLIST -->
    {content.buyerChecklist && content.buyerChecklist.items.length > 0 && (
      <BuyerChecklist
        locale={locale}
        headline={content.buyerChecklist.headline}
        subtitle={content.buyerChecklist.subtitle}
        items={content.buyerChecklist.items}
      />
    )}

    <!-- 23. CTA SECTION -->
    <ProductCTA
      locale={locale}
      productName={displayName}
      variant="primary"
      headline={content.cta?.final?.headline}
      subtitle={content.cta?.final?.subtitle}
      buttonLabel={content.cta?.final?.buttonLabel}
      showPhone={true}
    />

    <!-- 24. RELATED PRODUCTS (csak ha maradt testvér az összehasonlításon kívül) -->
    {showRelated && (
      <RelatedProducts
        locale={locale}
        currentSlug={product.slug}
        categorySlug={product.categorySlug}
        subtitle={isConsumable && locale === 'hu'
          ? 'Nézd meg a kategória további kezelőanyagait'
          : undefined}
      />
    )}

  </div>

  <script>
    import { trackViewItem } from '@/lib/tracking';

    function fireViewItem() {
      const el = document.getElementById('track-view-item');
      if (!el) return;
      trackViewItem({
        item_id: el.dataset.itemId || '',
        item_name: el.dataset.itemName || '',
        item_category: el.dataset.itemCategory || '',
        price: parseFloat(el.dataset.itemPrice || '0'),
        currency: 'HUF',
      });
    }

    document.addEventListener('astro:page-load', fireViewItem);
    if (document.readyState !== 'loading') fireViewItem();
  </script>
</BaseLayout>
