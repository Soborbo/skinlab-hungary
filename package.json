{
  "name": "skinlab-hungary",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/patch-wrangler-config.cjs && node scripts/verify-turnstile-build.cjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy --config dist/server/wrangler.json --keep-vars",
    "deploy:dry": "wrangler deploy --config dist/server/wrangler.json --keep-vars --dry-run",
    "generate:images": "node scripts/generate-optimized-images.cjs",
    "validate:content": "npx tsx scripts/validate-content.ts",
    "verify:clickids": "npx tsx scripts/verify-tracking-clickids.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "fuse.js": "^7.5.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.120.0",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "vite": "^8.0.0",
    "@emnapi/runtime": "^1.10.0",
    "@emnapi/core": "^1.10.0"
  }
}
