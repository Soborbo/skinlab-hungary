// Site worker config — read by @astrojs/cloudflare at build time and merged
// into the generated dist/server/wrangler.json (which scripts/
// patch-wrangler-config.cjs then post-processes; deploy: npm run deploy).
//
// `main` points at the custom Worker entry (src/worker.ts): it wraps the Astro
// SSR handler AND exports the daily synthetic-lead smoke `scheduled()` handler
// (soborbo-tracking). The GATEWAY service binding is how backend form
// conversions reach the event-gateway worker — a plain fetch to our own
// /api/event/* URL is short-circuited by Cloudflare loop protection.
//
// After every build, verify dist/server/wrangler.json carries main +
// triggers.crons + services (the skill's INSTALL.md step 3 hard check).
{
  "name": "skinlab-hungary",
  "main": "./src/worker.ts",
  "keep_vars": true,
  // Szerveroldali hibagyűjtés: a Soborbo error-notifier Tail Worker megkapja ennek
  // a workernek minden eseményét (uncaught exception → SRV-FUNC-001, ill. a
  // `__pipeline:"error"` console.error sorok) → ERROR_KV / error-admin.
  "tail_consumers": [
    { "service": "error-notifier" }
  ],
  "services": [
    { "binding": "GATEWAY", "service": "event-gateway" }
  ],
  "triggers": {
    // Daily smoke lead at 04:48 UTC — minute staggered per site so the
    // gateway logs stay readable (painless/beautyflow/lomtalan use others).
    "crons": ["48 4 * * *"]
  },
  // A kanonikus kit szerver-lába (soborbo-tracking 6.17.4) ezekből dolgozik.
  // Nem titkok. A `keep_vars` miatt a dashboard többi változója megmarad.
  "vars": {
    // A napi smoke-lead site-azonosítója — a gateway SMOKE_SITES-ében "skinlab".
    // Nélküle a kit 6.14+ smoke-ja NEM fut, és a digest napi hamis riasztást ad.
    "TRACKING_SITE_ID": "skinlab",
    // sbo alatt a szerver-láb KIZÁRÓLAG a saját sütit olvassa (nincs CookieYes-
    // visszaesés), és a régi tájékoztatóra adott döntést nem fogadja el.
    "TRACKING_CONSENT_PROVIDER": "sbo",
    // UGYANAZ, mint a .env.production PUBLIC_TRACKING_POLICY_VERSION-je — a két
    // láb ugyanarról a sütiről nem gondolhat mást (tests/tracking-config-parity).
    "TRACKING_POLICY_VERSION": "2026-09-18-a"
  }
}
