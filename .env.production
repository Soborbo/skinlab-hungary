# Build-time (Vite) values for the production build — NOT secrets, committed on
# purpose so the GitHub Actions / Workers builds and local builds produce the same
# page. (The local .env is gitignored, so before this file the CI build ran the
# tracking lib on its GB/GBP/en defaults.)

# Market — phone normalization, conversion currency, display strings.
PUBLIC_TRACKING_COUNTRY=HU
PUBLIC_TRACKING_CURRENCY=HUF
PUBLIC_TRACKING_LOCALE=hu

# Own CMP (sbo, soborbo-tracking 6.9.0) instead of CookieYes — owner decision
# 2026-09-18 (the CookieYes banner was disabled by its pageview limit). Skinlab
# is the fleet's second sbo site after Befilo. Rollback: delete these lines,
# restore cookieYesId on <Tracking /> in BaseLayout, redeploy, and set the gateway
# KV consent.provider back to "cookieyes" (Serverside docs/cmp-fazis2-pilot-runbook.md).
PUBLIC_TRACKING_CONSENT_PROVIDER=sbo
# The sbo_consent cookie is bound to this label: a new value re-asks every
# visitor, so bump it only when the cookie/privacy text really changes. The
# server leg (gateway-dispatch.ts) reads the same value from this file.
PUBLIC_TRACKING_POLICY_VERSION=2026-09-18-a
# Tools the GTM container (GTM-NW7DKC2D) actually runs: GA4, Google Ads with
# enhanced conversions, Meta Pixel. The banner copy and the privacy-page cookie
# table are built from this line — change it together with GTM, and bump the
# policy version above when it changes (the visitor must be asked again).
PUBLIC_TRACKING_VENDORS=ga4,google_ads,google_ec,meta
# Consent Mode (soborbo-tracking 6.10.0, owner decision 2026-10-16): advanced —
# GTM always loads under the denied default, so Google tags send cookieless pings
# for modelling before a decision and after a reject. Safe here because every
# non-Google tag in GTM-NW7DKC2D (the Meta Pixel ones) is gated on ad_storage
# (checked 2026-10-16, live version 8). The gateway KV consent.mode must match.
PUBLIC_TRACKING_CONSENT_MODE=advanced
# Highlighted Accept button (own colour, wider, larger text — like the stock
# CookieYes banner). Owner decision 2026-10-16, deliberately giving up button
# parity; banner_version gets a "-e" suffix so its accept rate is measured apart.
PUBLIC_TRACKING_CONSENT_ACCEPT_EMPHASIS=1
